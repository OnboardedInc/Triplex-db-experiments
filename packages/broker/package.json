{
  "name": "@triplex-build/triplex-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental engine-neutral durable host broker",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "import": "./dist/broker.js"
    },
    "./replica": {
      "types": "./dist/replica.d.ts",
      "import": "./dist/replica.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js"
    },
    "./feed": {
      "types": "./dist/feed.d.ts",
      "import": "./dist/feed.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js"
    },
    "./frames": {
      "types": "./dist/frames.d.ts",
      "import": "./dist/frames.js"
    },
    "./position": {
      "types": "./dist/position.d.ts",
      "import": "./dist/position.js"
    },
    "./crc32c": {
      "types": "./dist/crc32c.d.ts",
      "import": "./dist/crc32c.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./sqlite-worker": {
      "types": "./dist/sqlite-worker.d.ts",
      "import": "./dist/sqlite-worker.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@triplex-build/triplex": "workspace:^",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@triplex-build/triplex-testkit": "workspace:^",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
