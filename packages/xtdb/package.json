{
  "name": "@triplex-build/triplex-xtdb",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Onboarded",
  "description": "Independent XTDB 2 runtime for Triplex",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=120000 --hookTimeout=120000 --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@triplex-build/triplex": "workspace:^",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@triplex-build/triplex-testkit": "workspace:^",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
