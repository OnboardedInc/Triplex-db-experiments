{
  "name": "@triplex-build/triplex-duckdb",
  "version": "0.0.0",
  "private": true,
  "files": ["dist", "LICENSE", "README.md"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
