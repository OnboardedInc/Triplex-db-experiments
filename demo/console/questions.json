[
  {
    "name": "Everything recorded about this subject",
    "note": "The whole pull as bindings: every entity, attribute and value of the subject at one position.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": { "find": ["?entity", "?attribute", "?value"], "where": [["?entity", "?attribute", "?value"]] }
  },
  {
    "name": "This subject's tasks and their progress",
    "note": "A join through two references: root, placement, task. The gateway refuses this join when it is sent to the store.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": {
      "find": ["?task", "?progress"],
      "where": [
        ["acct/account-003/pl:00050000", ":person/placement", "?placement"],
        ["?placement", ":placement/task", "?task"],
        ["?task", ":task/progress", "?progress"]
      ]
    }
  },
  {
    "name": "Tasks that are not complete",
    "note": "Negation with a bound variable.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": {
      "find": ["?task"],
      "where": [["?placement", ":placement/task", "?task"], ["not", ["?task", ":task/status", "complete"]]]
    }
  },
  {
    "name": "Subtasks per task",
    "note": "A grouped count, ordered. Two columns, one text and one number, so the Chart tab is offered.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": {
      "find": ["?task", "?subtasks"],
      "where": [["?task", ":task/subtask", "?subtask"]],
      "aggregate": [["count", "?subtask", "?subtasks"]],
      "orderBy": [{ "variable": "?subtasks", "direction": "desc" }]
    }
  },
  {
    "name": "Every step reachable from the first task",
    "note": "Triplex's bounded recursive rule over :task/subtask and :subtask/next.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": {
      "find": ["?step"],
      "where": [["step", "acct/account-003/i9:00050000", "?step"]],
      "rules": [
        { "name": "step", "body": [["?x", ":task/subtask", "?y"]] },
        { "name": "step", "body": [["?x", ":subtask/next", "?y"]] },
        { "name": "step", "body": [["?x", ":task/subtask", "?z"], ["step", "?z", "?y"]] },
        { "name": "step", "body": [["?x", ":subtask/next", "?z"], ["step", "?z", "?y"]] }
      ]
    }
  },
  {
    "name": "Tasks with progress of 10 or more",
    "note": "A numeric comparison on an exact integer, evaluated as a number (the column is labelled).",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "query": { "find": ["?task", "?progress"], "where": [["?task", ":task/progress", "?progress"], [">=", "?progress", 10]] }
  },
  {
    "name": "The same question at the sealed head",
    "note": "Tasks that are not complete, read at the exact position the 1 billion database was sealed at.",
    "from": { "subject": { "account": "account-003", "subject": 50000 } },
    "basis": { "position": 28309866 },
    "query": {
      "find": ["?task"],
      "where": [["?placement", ":placement/task", "?task"], ["not", ["?task", ":task/status", "complete"]]]
    }
  },
  {
    "name": "Tasks not complete, per subject, for subjects 50000 to 50015",
    "note": "Sixteen subjects pulled at one identical position in one request, then one count per subject.",
    "from": { "subjects": { "account": "account-003", "subjects": [50000, 50001, 50002, 50003, 50004, 50005, 50006, 50007, 50008, 50009, 50010, 50011, 50012, 50013, 50014, 50015] } },
    "query": {
      "find": ["?subject", "?open"],
      "where": [
        ["?subject", ":person/placement", "?placement"],
        ["?placement", ":placement/task", "?task"],
        ["not", ["?task", ":task/status", "complete"]]
      ],
      "aggregate": [["count", "?task", "?open"]]
    }
  },
  {
    "name": "One task's status, answered by the store",
    "note": "Every pattern names its entity, so the store answers it; the Plan tab shows the Datomic query Triplex compiled.",
    "from": "store",
    "explain": true,
    "query": { "find": ["?status"], "where": [["acct/account-003/i9:00050000", ":task/status", "?status"]] }
  },
  {
    "name": "Every complete task in the database",
    "note": "A whole-database question. Refused before it is sent, with the reason and the missing index.",
    "from": "store",
    "expect": "refused",
    "query": { "find": ["?task"], "where": [["?task", ":task/status", "complete"]] }
  }
]
