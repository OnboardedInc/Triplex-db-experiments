      "url": "https://github.com/duckdb/duckdb/blob/d54cbbe3df17e8e5ce68312f483b4155836112aa/src/main/extension/extension_load.cpp",
      "source_sha256": "595bed7921a693fa497f9eae7c68f6e293c40719fa3a12be8a190f5e7bdb7086",
      "ranges": [
        {
          "first": 27,
          "last": 36,
          "lines": [
            {
              "line": 27,
              "text": "//! Which C API family an extension targets. C_STRUCT_UNSTABLE always means V2: everything that was unstable in the V1"
            },
            {
              "line": 28,
              "text": "//! API was stabilized into v1.5.6, so a V1 extension pins that version rather than building against \"unstable\"."
            },
            {
              "line": 29,
              "text": "static bool UsesCAPIV2(const ExtensionInitResult &init_result) {"
            },
            {
              "line": 30,
              "text": "\tif (init_result.abi_type == ExtensionABIType::C_STRUCT_UNSTABLE) {"
            },
            {
              "line": 31,
              "text": "\t\treturn true;"
            },
            {
              "line": 32,
              "text": "\t}"
            },
            {
              "line": 33,
              "text": "\tif (init_result.abi_type != ExtensionABIType::C_STRUCT) {"
            },
            {
              "line": 34,
              "text": "\t\treturn false;"
            },
            {
              "line": 35,
              "text": "\t}"
            },
            {
              "line": 36,
              "text": "\treturn VersioningUtils::IsCAPIV2Version(init_result.duckdb_capi_version);"
            }
          ]
        },
        {
          "first": 829,
          "last": 845,
          "lines": [
            {
              "line": 829,
              "text": ""
            },
            {
              "line": 830,
              "text": "\t// C ABI, V2"
            },
            {
              "line": 831,
              "text": "\tif (UsesCAPIV2(extension_init_result)) {"
            },
            {
              "line": 832,
              "text": "\t\tauto init_fun_name = extension_init_result.filebase + \"_init_c_api_v2\";"
            },
            {
              "line": 833,
              "text": "\t\tauto init_fun_capi_v2 = reinterpret_cast<ext_init_c_api_v2_fun_t>("
            },
            {
              "line": 834,
              "text": "\t\t    db.config.GetExternalExtensionProvider().TryLoadFunction(extension_init_result.lib_hdl, init_fun_name));"
            },
            {
              "line": 835,
              "text": ""
            },
            {
              "line": 836,
              "text": "\t\tif (!init_fun_capi_v2) {"
            },
            {
              "line": 837,
              "text": "\t\t\tthrow IOException("
            },
            {
              "line": 838,
              "text": "\t\t\t    \"File \\\"%s\\\" did not contain function \\\"%s\\\". Extensions built against the unstable C API, or against \""
            },
            {
              "line": 839,
              "text": "\t\t\t    \"C API v2.x.y, must use the entrypoint from duckdb_extension_v2.h. To keep using the V1 C API, pin it \""
            },
            {
              "line": 840,
              "text": "\t\t\t    \"with build_loadable_extension_capi(%s 1 5 6 ...), which provides \\\"%s_init_c_api\\\" instead.\","
            },
            {
              "line": 841,
              "text": "\t\t\t    extension_init_result.filename, init_fun_name, extension_init_result.filebase,"
            },
            {
              "line": 842,
              "text": "\t\t\t    extension_init_result.filebase);"
            },
            {
              "line": 843,
              "text": "\t\t}"
            },
            {
              "line": 844,
              "text": ""
            },
            {
              "line": 845,
              "text": "\t\tdb.InvokeExtensionEntrypointV2(extension_init_result, extension, init_fun_capi_v2, context,"
            }
          ]
        }
      ]
    },
