        {
          "first": 829,
          "last": 838,
          "lines": [
            {
              "line": 829,
              "text": "# Build without C++ RTTI. A dependency that cannot build this way can re-enable"
            },
            {
              "line": 830,
              "text": "# it for its own targets, but only if its class hierarchy is self-contained: a"
            },
            {
              "line": 831,
              "text": "# type deriving from a duckdb type needs the base's typeinfo, which this build"
            },
            {
              "line": 832,
              "text": "# never emits."
            },
            {
              "line": 833,
              "text": "if(DISABLE_RTTI)"
            },
            {
              "line": 834,
              "text": "  if(MSVC)"
            },
            {
              "line": 835,
              "text": "    set(CMAKE_CXX_FLAGS \"${CMAKE_CXX_FLAGS} /GR-\")"
            },
            {
              "line": 836,
              "text": "  else()"
            },
            {
              "line": 837,
              "text": "    set(CMAKE_CXX_FLAGS \"${CMAKE_CXX_FLAGS} -fno-rtti\")"
            },
            {
              "line": 838,
              "text": "  endif()"
            }
          ]
        },
