              "line": 542,
              "text": "vector<shared_ptr<AttachedDatabase>> DatabaseManager::GetDatabases(ClientContext &context,"
            },
            {
              "line": 543,
              "text": "                                                                   const optional_idx max_db_count) {"
            },
            {
              "line": 544,
              "text": "\tvector<shared_ptr<AttachedDatabase>> result;"
            },
            {
              "line": 545,
              "text": ""
            },
            {
              "line": 546,
              "text": "\tlock_guard<mutex> guard(databases_lock);"
            },
            {
              "line": 547,
              "text": "\tidx_t count = 2;"
            },
            {
              "line": 548,
              "text": "\tfor (auto &entry : databases) {"
            },
            {
              "line": 549,
              "text": "\t\tif (max_db_count.IsValid() && count >= max_db_count.GetIndex()) {"
            },
            {
              "line": 550,
              "text": "\t\t\tbreak;"
            },
            {
              "line": 551,
              "text": "\t\t}"
            },
            {
              "line": 552,
              "text": "\t\tresult.push_back(entry.second);"
            },
            {
              "line": 553,
              "text": "\t\tcount++;"
            },
            {
              "line": 554,
              "text": "\t}"
            },
            {
              "line": 555,
              "text": "\tif (!max_db_count.IsValid() || max_db_count.GetIndex() >= 1) {"
            },
            {
              "line": 556,
              "text": "\t\tresult.push_back(system);"
            },
            {
              "line": 557,
              "text": "\t}"
            },
            {
              "line": 558,
              "text": "\tif (!max_db_count.IsValid() || max_db_count.GetIndex() >= 2) {"
            },
            {
              "line": 559,
              "text": "\t\tresult.push_back(context.client_data->temporary_objects);"
            },
            {
              "line": 560,
              "text": "\t}"
            },
            {
              "line": 561,
              "text": ""
            },
            {
              "line": 562,
