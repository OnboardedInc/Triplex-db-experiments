    "query": {
        "cpu_time": 0.0009084980000000009,
        "sql": "CREATE TEMP TABLE __td_reference_guard AS WITH coverage_policies AS MATERIALIZED (SELECT p.* FROM td_catalog_v1.schema_reference_coverage p CROSS JOIN __td_native_ctx c WHERE NOT c.is_replay), coverage_candidates AS MATERIALIZED (SELECT a.assertion_id,a.e source_id,decode(a.v_s) target_id,a.valid_from lo,a.valid_to hi,a.tx_from,a.tx_to FROM main.assertions a SEMI JOIN coverage_policies admitted ON admitted.attribute=a.a LEFT JOIN td_catalog_v1.entity_assertion_sources origin ON origin.assertion_id=a.assertion_id JOIN td_catalog_v1.entity_creators validator ON validator.entity_id=a.e AND validator.command_id=coalesce(origin.validation_command_id,a.command_id) JOIN coverage_policies policy ON policy.schema_name=validator.schema_name AND policy.version=validator.schema_version AND policy.entity_type=validator.entity_type AND policy.attribute=a.a WHERE a.tx_to=9223372036854775807 AND NOT EXISTS(SELECT 1 FROM __td_native_old old WHERE old.assertion_id=a.assertion_id) AND (a.e IN(SELECT entity_id FROM __td_native_ctx WHERE NOT is_replay) OR decode(a.v_s) IN(SELECT entity_id FROM __td_native_ctx WHERE NOT is_replay)) UNION ALL SELECT p.assertion_id,p.e,decode(p.v_s),p.valid_from,p.valid_to,c.position,9223372036854775807 FROM (SELECT p.*,c.schema_name,c.schema_version,c.entity_type FROM __td_native_pending p CROSS JOIN __td_native_ctx c WHERE NOT c.is_replay) p CROSS JOIN __td_native_ctx c LEFT JOIN td_catalog_v1.entity_creators validator ON validator.entity_id=p.e AND validator.command_id=p.validation_command_id JOIN coverage_policies policy ON policy.schema_name=CASE WHEN p.validation_command_id IS NULL THEN p.schema_name ELSE validator.schema_name END AND policy.version=CASE WHEN p.validation_command_id IS NULL THEN p.schema_version ELSE validator.schema_version END AND policy.entity_type=CASE WHEN p.validation_command_id IS NULL THEN p.entity_type ELSE validator.entity_type END AND policy.attribute=p.a WHERE NOT c.is_replay LIMIT 4097), coverage_candidate_guard AS MATERIALIZED (SELECT CASE WHEN (SELECT count(*) FROM coverage_candidates)>4096 THEN error('TD_E_COMMAND_REFERENCE_LIMIT: affected reference row admission exceeded') ELSE TRUE END ok), \ncoverage_scope AS MATERIALIZED (\n SELECT entity_id FROM (SELECT source_id entity_id FROM coverage_candidates\n UNION SELECT target_id FROM coverage_candidates) ids CROSS JOIN coverage_candidate_guard g WHERE g.ok LIMIT 33\n), coverage_scope_guard AS MATERIALIZED (SELECT CASE WHEN count(*)>32\n THEN error('TD_E_COMMAND_REFERENCE_LIMIT: reference entity scope admission exceeded') ELSE TRUE END ok\n FROM coverage_scope),\npresence_scoped AS MATERIALIZED (SELECT e.entity_id,e.position,e.operation,e.valid_from lo,e.valid_to hi FROM td_catalog_v1.entity_presence_events e JOIN coverage_scope s USING(entity_id) CROSS JOIN __td_native_ctx c CROSS JOIN coverage_scope_guard g WHERE g.ok AND e.position<=c.position AND NOT c.is_replay UNION ALL SELECT e.entity_id,e.position,e.operation,e.lo,e.hi FROM (SELECT entity_id,position,'patch' operation,valid_from lo,valid_to hi FROM __td_native_ctx WHERE is_live_type AND NOT is_replay) e JOIN coverage_scope s USING(entity_id) CROSS JOIN coverage_scope_guard g WHERE g.ok LIMIT 4097), \npresence_guard AS MATERIALIZED (SELECT CASE WHEN count(*)>4096\n THEN error('TD_E_COMMAND_REFERENCE_LIMIT: reference presence event admission exceeded') ELSE TRUE END ok\n FROM presence_scoped), presence_events AS MATERIALIZED (\n SELECT e.* FROM presence_scoped e CROSS JOIN presence_guard g WHERE g.ok\n)\n\n, presence_last_put AS (\n SELECT entity_id,max(position) FILTER(WHERE operation='put') last_put\n FROM presence_events GROUP BY entity_id\n), presence_eligible AS (\n SELECT e.entity_id,e.position,e.lo,e.hi\n FROM presence_events e JOIN presence_last_put p USING(entity_id)\n WHERE (e.operation='put' AND e.position=p.last_put)\n    OR (e.operation='patch' AND (p.last_put IS NULL OR e.position>p.last_put))\n), presence_ordered AS (\n SELECT *,max(hi) OVER(PARTITION BY entity_id ORDER BY lo,hi,position\n   ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) prior_hi\n FROM presence_eligible\n), presence_marked AS (\n SELECT *,CASE WHEN prior_hi IS NULL OR lo>prior_hi THEN 1 ELSE 0 END starts\n FROM presence_ordered\n), presence_grouped AS (\n SELECT *,sum(starts) OVER(PARTITION BY entity_id ORDER BY lo,hi,position\n   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) island\n FROM presence_marked\n), presence_islands AS MATERIALIZED (\n SELECT entity_id,min(lo) lo,max(hi) hi\n FROM presence_grouped GROUP BY entity_id,island\n)\n SELECT CASE WHEN (SELECT count(*) FROM presence_islands)>4096 OR (SELECT coalesce(sum(octet_length(encode(assertion_id))+octet_length(encode(source_id))+octet_length(encode(target_id))+16),0) FROM coverage_candidates)+(SELECT coalesce(sum(octet_length(encode(entity_id))+octet_length(encode(operation))+24),0) FROM presence_scoped)+(SELECT coalesce(sum(octet_length(encode(entity_id))+16),0) FROM presence_islands)>1048576 OR (SELECT coalesce(sum(edges.n::HUGEINT*islands.n),0) FROM (SELECT entity_id,count(*) n FROM (SELECT source_id entity_id FROM coverage_candidates UNION ALL SELECT target_id FROM coverage_candidates) ids GROUP BY entity_id) edges JOIN (SELECT entity_id,count(*) n FROM presence_islands GROUP BY entity_id) islands USING(entity_id))>65536 THEN error('TD_E_COMMAND_REFERENCE_LIMIT: reference logical work or byte admission exceeded')  WHEN EXISTS(SELECT 1 FROM coverage_candidates e WHERE NOT EXISTS(SELECT 1 FROM presence_islands p WHERE p.entity_id=e.source_id AND p.lo<=e.lo AND p.hi>=e.hi)) THEN error('TD_E_COMMAND_REFERENCE_SOURCE: complete reference interval lacks source presence') WHEN EXISTS(SELECT 1 FROM coverage_candidates e WHERE NOT EXISTS(SELECT 1 FROM presence_islands p WHERE p.entity_id=e.target_id AND p.lo<=e.lo AND p.hi>=e.hi)) THEN error('TD_E_COMMAND_REFERENCE_COVERAGE: complete reference interval lacks target presence') ELSE 1 END checked FROM coverage_candidate_guard candidates CROSS JOIN coverage_scope_guard scope_guard CROSS JOIN presence_guard events WHERE candidates.ok AND scope_guard.ok AND events.ok;",
        "total_intermediate_rows": 216,
