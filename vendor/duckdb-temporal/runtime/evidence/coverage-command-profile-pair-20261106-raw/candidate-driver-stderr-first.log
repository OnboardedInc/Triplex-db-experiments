    "query": {
        "cpu_time": 0.00018191500000000002,
        "sql": "CREATE TEMP TABLE __td_native_owner_guard AS SELECT CASE WHEN system.main.td_owner_probe_validated_check() IS NOT TRUE THEN error('TD_E_OWNER_PROBE_INVALID: owner scope is not audited') WHEN NOT (SELECT ok FROM (SELECT CASE\n WHEN (SELECT count(*) FROM main.store_meta)<>1 OR EXISTS(\n   SELECT 1 FROM main.store_meta WHERE version IS NULL OR version NOT IN(5,6,8,9,10,11,12))\n THEN error('TD_E_COMMAND_FORMAT: unsupported native store format')\n WHEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)>1 OR EXISTS(\n   SELECT 1 FROM td_catalog_v1.catalog_revision WHERE singleton IS DISTINCT FROM TRUE OR revision IS NULL OR revision NOT IN(2,3))\n THEN error('TD_E_COMMAND_FORMAT: unsupported native catalog revision')\n WHEN EXISTS(SELECT 1 FROM main.store_meta m WHERE CASE m.version\n   WHEN 5 THEN EXISTS(SELECT 1 FROM td_catalog_v1.catalog_revision WHERE revision<>2)\n   WHEN 9 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 10 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 11 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 12 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   ELSE (SELECT count(*) FROM td_catalog_v1.catalog_revision WHERE revision=2)<>1 END)\n THEN error('TD_E_COMMAND_FORMAT: native format/catalog revision mismatch')\n ELSE TRUE END ok) native_format) THEN error('TD_E_COMMAND_FORMAT: unsupported native catalog') WHEN (SELECT count(*) FROM system.main.pragma_database_list)<>1 THEN error('TD_E_QUERY_CATALOG: visible extra attachments are unsupported') WHEN system.main.td_float_from_bits_v1('0000000000000000')<>0 THEN error('TD_E_QUERY_PROFILE: invalid float codec') ELSE TRUE END ok;",
        "total_intermediate_rows": 46,
        "total_intermediate_size_bytes": 18332,
        "total_row_groups_scanned": 3,
        "total_row_groups_to_scan": 3,
        "total_rows_scanned": 3,
        "total_time": 0.011051708
    },
