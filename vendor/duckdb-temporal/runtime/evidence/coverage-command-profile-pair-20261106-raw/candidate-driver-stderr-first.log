        "sql": "WITH owner_guard AS MATERIALIZED (SELECT CASE WHEN system.main.td_owner_probe_validated_check() IS NOT TRUE THEN error('TD_E_OWNER_PROBE_INVALID: owner scope is not audited') WHEN NOT (SELECT ok FROM (SELECT CASE\n WHEN (SELECT count(*) FROM main.store_meta)<>1 OR EXISTS(\n   SELECT 1 FROM main.store_meta WHERE version IS NULL OR version NOT IN(5,6,8,9,10,11,12))\n THEN error('TD_E_COMMAND_FORMAT: unsupported native store format')\n WHEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)>1 OR EXISTS(\n   SELECT 1 FROM td_catalog_v1.catalog_revision WHERE singleton IS DISTINCT FROM TRUE OR revision IS NULL OR revision NOT IN(2,3))\n THEN error('TD_E_COMMAND_FORMAT: unsupported native catalog revision')\n WHEN EXISTS(SELECT 1 FROM main.store_meta m WHERE CASE m.version\n   WHEN 5 THEN EXISTS(SELECT 1 FROM td_catalog_v1.catalog_revision WHERE revision<>2)\n   WHEN 9 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 10 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 11 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   WHEN 12 THEN (SELECT count(*) FROM td_catalog_v1.catalog_revision)<>1\n   ELSE (SELECT count(*) FROM td_catalog_v1.catalog_revision WHERE revision=2)<>1 END)\n THEN error('TD_E_COMMAND_FORMAT: native format/catalog revision mismatch')\n ELSE TRUE END ok) native_format) THEN error('TD_E_COMMAND_FORMAT: unsupported native catalog') WHEN (SELECT count(*) FROM system.main.pragma_database_list)<>1 THEN error('TD_E_QUERY_CATALOG: visible extra attachments are unsupported') WHEN system.main.td_float_from_bits_v1('0000000000000000')<>0 THEN error('TD_E_QUERY_PROFILE: invalid float codec') ELSE TRUE END ok) SELECT CASE WHEN n.command_id IS NULL THEN error('TD_E_COMMAND_KIND: command belongs to another API') ELSE c.command_id END command_id,c.position,CAST(json_extract(c.receipt,'$.asserted') AS VARCHAR) asserted,CAST(json_extract(c.receipt,'$.retracted') AS VARCHAR) retracted,n.schema_name,n.schema_version,n.entity_type,n.entity_id,n.schema_hash,c.request_hash FROM main.commands c LEFT JOIN td_catalog_v1.entity_commands n ON n.command_id=c.command_id CROSS JOIN owner_guard WHERE owner_guard.ok AND c.command_id='measure-4' UNION ALL SELECT NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL FROM owner_guard WHERE NOT ok",
