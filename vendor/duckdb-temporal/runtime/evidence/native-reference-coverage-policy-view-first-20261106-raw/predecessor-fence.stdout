:24ee22e24dda6fd3f85d2d10f25474b59a613f71f55176a8e341b56e2b075fe7"]]},{"table":["td_catalog_v1","schemas"],"rows":[["coverage_boundary",1,"schema coverage_boundary version 1 {entity T live {} entity S live {to:ref_value(T) many coverage;}}","{\"format\":\"td.schema/5\",\"name\":\"coverage_boundary\",\"version\":1,\"entities\":[{\"name\":\"S\",\"live\":true,\"attributes\":[{\"key\":\"to\",\"tag\":5,\"required\":false,\"many\":true,\"reference\":\"T\",\"reference_policy\":\"coverage\"}]},{\"name\":\"T\",\"live\":true,\"attributes\":[]}]}","3756f41c55a6116cfc839db26960fea1a931479ea237cac60571a344a9ff0d2c"],["coverage_old1",1,"schema coverage_old1 version 1 {entity R {a:text;b:boolean;c:int64;d:float64;}}","{\"format\":\"td.schema/1\",\"name\":\"coverage_old1\",\"version\":1,\"entities\":[{\"name\":\"R\",\"attributes\":[{\"key\":\"a\",\"tag\":1,\"required\":false,\"many\":false},{\"key\":\"b\",\"tag\":2,\"required\":false,\"many\":false},{\"key\":\"c\",\"tag\":3,\"required\":false,\"many\":false},{\"key\":\"d\",\"tag\":4,\"required\":false,\"many\":false}]}]}","d4a051ec2ec8c1c8e26467c3f0419a66907a05e2ccaadf0848743e4dcd96f0f2"],["coverage_old2",1,"schema coverage_old2 version 1 {entity R {a:datetime;b:ref_value(R);}}","{\"format\":\"td.schema/2\",\"name\":\"coverage_old2\",\"version\":1,\"entities\":[{\"name\":\"R\",\"attributes\":[{\"key\":\"a\",\"tag\":6,\"required\":false,\"many\":false},{\"key\":\"b\",\"tag\":5,\"required\":false,\"many\":false,\"reference\":\"R\"}]}]}","44d78efcd032a53cdbeab7f98256f657b8a9c032fcb97f50a6b8adbc75e93b23"],["coverage_old3",1,"schema coverage_old3 version 1 {entity R {a:text unique;}}","{\"format\":\"td.schema/3\",\"name\":\"coverage_old3\",\"version\":1,\"entities\":[{\"name\":\"R\",\"attributes\":[{\"key\":\"a\",\"tag\":1,\"required\":false,\"many\":false,\"unique\":true}]}]}","b2203a6f7566d3f55a49f7d6c0df95fb1e4f0ff495dd20bbf63fff29240988b5"],["coverage_old4",1,"schema coverage_old4 version 1 {entity R live {}}","{\"format\":\"td.schema/4\",\"name\":\"coverage_old4\",\"version\":1,\"entities\":[{\"name\":\"R\",\"live\":true,\"attributes\":[]}]}","6a8bddafe488f1682d1935e28a8b6eafa61fafab357d14efdef25979c4e4928b"]]}],"views":[["attributes","CREATE VIEW td_catalog_v1.attributes AS SELECT s.\"name\" AS schema_name, s.\"version\", json_extract_string(e.\"value\", '$.name') AS entity_name, json_extract_string(a.\"value\", '$.key') AS attribute_key, CAST(json_extract(a.\"value\", '$.tag') AS UTINYINT) AS value_tag, CAST(json_extract(a.\"value\", '$.required') AS BOOLEAN) AS required, CAST(json_extract(a.\"value\", '$.many') AS BOOLEAN) AS many, json_extract_string(a.\"value\", '$.reference') AS reference_type FROM td_catalog_v1.\"schemas\" AS s , json_each(s.ir, '$.entities') AS e , json_each(e.\"value\", '$.attributes') AS a;"],["entities","CREATE VIEW td_catalog_v1.entities AS SELECT s.\"name\" AS schema_name, s.\"version\", s.content_hash, json_extract_string(e.\"value\", '$.name') AS entity_name FROM td_catalog_v1.\"schemas\" AS s , json_each(s.ir, '$.entities') AS e;"],["entity_command_intervals","CREATE VIEW td_catalog_v1.entity_command_intervals AS (SELECT p.command_id, n.entity_id, p.valid_from, p.valid_to, false AS is_batch, true AS allows_carry FROM (td_catalog_v1.entity_patch_commands AS p INNER JOIN td_catalog_v1.entity_commands AS n USING (command_id))) UNION ALL (SELECT command_id, entity_id, valid_from, valid_to, false AS is_batch, false AS allows_carry FROM td_catalog_v1.entity_presence_edits WHERE (operation = 'put'))UNION ALL (SELECT command_id, entity_id, valid_from, valid_to, true AS is_batch, (operation = 'patch') AS allows_carry FROM td_catalog_v1.entity_batch_members);"],["entity_creators","CREATE VIEW td_catalog_v1.entity_creators AS (SELECT command_id, schema_name, schema_version, entity_type, entity_id, \"position\", schema_hash FROM td_catalog_v1.entity_commands) UNION ALL (SELECT b.command_id, b.schema_name, b.schema_version, m.entity_type, m.entity_id, c.\"position\", b.schema_hash FROM ((td_catalog_v1.entity_batches AS b INNER JOIN td_catalog_v1.entity_batch_members AS m USING (command_id)) INNER JOIN main.commands AS c USING (command_id)));"],["entity_history","CREATE VIEW td_catalog_v1.entity_history AS WITH source_ids AS MATERIALIZED (SELECT DISTINCT source_assertion_id FROM td_catalog_v1.entity_assertion_sources), source_rows AS MATERIALIZED (SELECT \"source\".assertion_id, \"source\".command_id, \"source\".e, \"source\".a, \"source\".tag, \"source\".payload, \"source\".extra_json, \"source\".entity_type, \"source\".tx_from, \"source\".tx_to, \"source\".corrected_by, \"source\".valid_from, \"source\".valid_to FROM (main.assertions AS \"source\" SEMI JOIN source_ids AS ids ON ((\"source\".assertion_id = ids.source_assertion_id)))) SELECT a.assertion_id, a.e AS entity_id, a.a AS \"attribute\", a.tag, a.payload, a.valid_from, a.valid_to, a.tx_from, a.tx_to, a.command_id, a.corrected_by, v.schema_name, v.schema_version, v.entity_type, v.schema_hash FROM (((((((((((main.assertions AS a LEFT JOIN td_catalog_v1.entity_creators AS n ON (((n.command_id = a.command_id) AND (n.entity_id = a.e)))) LEFT JOIN td_catalog_v1.entity_assertion_sources AS provenance ON ((provenance.assertion_id = a.assertion_id))) LEFT JOIN source_rows AS \"source\" ON ((\"source\".assertion_id = provenance.source_assertion_id))) LEFT JOIN td_catalog_v1.entity_assertion_sources AS source_origin ON ((source_origin.assertion_id = \"source\".assertion_id))) LEFT JOIN td_catalog_v1.entity_command_intervals AS member_interval ON (((member_interval.command_id = a.command_id) AND (member_interval.entity_id = a.e)))) LEFT JOIN td_catalog_v1.entity_creators AS v ON (((v.command_id = COALESCE(provenance.validation_command_id, a.command_id)) AND (v.entity_id = a.e)))) LEFT JOIN td_catalog_v1.entity_owners AS \"owner\" ON ((\"owner\".entity_id = a.e))) LEFT JOIN td_catalog_v1.\"schemas\" AS s ON (((s.\"name\" = v.schema_name) AND (s.\"version\" = v.schema_version)))) LEFT JOIN main.commands AS c ON ((c.command_id = a.command_id))) LEFT JOIN td_catalog_v1.schema_references AS r ON (((r.schema_name = v.schema_name) AND (r.\"version\" = v.schema_version) AND (r.entity_type = v.entity_type) AND (r.\"attribute\" = a.a)))) LEFT JOIN td_catalog_v1.entity_identities AS \"target\" ON (((r.reference_type = \"target\".entity_type) AND (\"target\".schema_name = v.schema_name) AND (\"target\".entity_id = decode(a.v_s))))) WHERE CASE  WHEN (((n.command_id IS NULL) AND (\"owner\".entity_id IS NULL) AND (NOT COALESCE(((c.origin = 'triplex') AND (c.request_hash IS NOT NULL)), false)))) THEN (false) WHEN ((n.command_id IS NULL)) THEN (\"error\"('TD_E_COMMAND_HISTORY: native creator binding is missing')) WHEN ((v.command_id IS NULL)) THEN (\"error\"('TD_E_COMMAND_HISTORY: native validation binding is missing')) WHEN ((CAST(((s.content_hash = v.schema_hash) AND (c.\"position\" = n.\"position\") AND (a.tx_from = n.\"position\") AND (a.e = n.entity_id) AND (a.entity_type = n.entity_type) AND (a.payload_hash = sha256(a.payload)) AND (\"owner\".schema_name = n.schema_name) AND (\"owner\".entity_type = n.entity_type) AND (v.schema_name = n.schema_name) AND (v.entity_type = n.entity_type) AND (v.entity_id = a.e) AND \"system\".main.td_validate_schema_fact_v2(s.dsl, s.ir, v.entity_type, a.a, a.v_tag) AND ((r.reference_type IS NULL) OR (\"target\".first_position <= v.\"position\")) AND CASE  WHEN ((provenance.assertion_id IS NULL)) THEN (((member_interval.command_id IS NULL) OR ((a.valid_from = member_interval.valid_from) AND (a.valid_to = member_interval.valid_to)))) ELSE (member_interval.allows_carry AND (\"source\".assertion_id IS NOT NULL) AND (provenance.validation_command_id = COALESCE(source_origin.validation_command_id, \"source\".command_id)) AND (v.\"position\" <= \"source\".tx_from) AND (\"source\".tx_from < a.tx_from) AND (\"source\".tx_to = a.tx_from) AND (\"source\".corrected_by = a.command_id) AND (\"source\".e = a.e) AND (\"source\".a = a.a) AND (\"source\".tag = a.tag) AND (\"source\".payload = a.payload) AND (\"source\".extra_json IS NOT DISTINCT FROM a.extra_json) AND (\"source\".entity_type = a.entity_type) AND (\"source\".valid_from < member_interval.valid_to) AND (\"source\".valid_to > member_interval.valid_from) AND CASE  WHEN ((provenance.side = 'left')) THEN (((a.valid_from = \"source\".valid_from) AND (a.valid_to = member_interval.valid_from) AND (\"source\".valid_from < member_interval.valid_from))) WHEN ((provenance.side = 'right')) THEN (((a.valid_from = member_interval.valid_to) AND (a.valid_to = \"source\".valid_to) AND (member_interval.valid_to < \"source\".valid_to))) ELSE false END AND (a.assertion_id = CASE  WHEN (member_interval.is_batch) THEN (sha256(to_json(struct_pack(kind := 'td.entity.batch.fragment/1', command_id := a.command_id, entity_id := a.e, source_assertion_id := \"source\".assertion_id, side := provenance.side)))) ELSE sha256(to_json(struct_pack(kind := 'td.entity.patch.fragment/1', command_id := a.command_id, source_assertion_id := \"source\".assertion_id, side := provenance.side))) END)) END AND CASE  WHEN ((a.tag = 'str')) THEN (((a.v_tag = 1) AND (json_extract_string(a.payload, '$') = decode(a.v_s)) AND (json_type(a.payload) = 'VARCHAR'))) WHEN ((a.tag = 'bool')) THEN (((a.v_tag = 2) AND (a.payload = CAST(to_json(a.v_b) AS VARCHAR)))) WHEN ((a.tag = 'i64')) THEN (((a.v_tag = 3) AND (json_extract_string(a.payload, '$') = CAST(a.v_i AS VARCHAR)) AND (json_type(a.payload) = 'VARCHAR'))) WHEN ((a.tag = 'f64')) THEN (((a.v_tag = 4) AND (json_extract_string(a.payload, '$') = \"system\".main.td_float_bits_v1(a.v_f)) AND (json_type(a.payload) = 'VARCHAR'))) WHEN ((a.tag = 'ref')) THEN (((a.v_tag = 5) AND (octet_length(a.v_s) BETWEEN 1 AND 128) AND (json_extract_string(a.payload, '$') = decode(a.v_s)) AND (json_type(a.payload) = 'VARCHAR'))) WHEN ((a.tag = 'datetime')) THEN (((a.v_tag = 6) AND (json_extract_string(a.payload, '$') = \"system\".main.td_float_bits_v1(a.v_f)) AND (json_type(a.payload) = 'VARCHAR'))) WHEN ((a.tag = 'json')) THEN (((a.v_tag = 7) AND (json_type(a.payload) = 'VARCHAR') AND (a.extra_json IS NULL) AND (a.v_s = encode(json_extract_string(a.payload, '$'))) AND \"system\".main.td_validate_json_source_v2(decode(a.v_s)))) WHEN ((a.tag = 'blob')) THEN (((a.v_tag = 8) AND \"system\".main.td_validate_blob_descriptor_v2(a.payload, decode(a.v_s), a.extra_json))) ELSE false END) AS BOOLEAN) IS NOT DISTINCT FROM true)) THEN (true) ELSE \"error\"('TD_E_COMMAND_HISTORY: native history binding or carrier is inconsistent') END;"],["entity_identities","CREATE VIEW td_catalog_v1.entity_identities AS SELECT o.entity_id, o.schema_name, o.entity_type, min(n.\"position\") AS first_position FROM ((((td_catalog_v1.entity_owners AS o INNER JOIN td_catalog_v1.entity_creators AS n ON (((n.entity_id = o.entity_id) AND (n.schema_name = o.schema_name) AND (n.entity_type = o.entity_type)))) INNER JOIN main.commands AS c ON (((c.command_id = n.command_id) AND (c.\"position\" = n.\"position\") AND (c.origin = 'triplex')))) INNER JOIN td_catalog_v1.\"schemas\" AS s ON (((s.\"name\" = n.schema_name) AND (s.\"version\" = n.schema_version) AND (s.content_hash = n.schema_hash)))) INNER JOIN td_catalog_v1.entities AS e ON (((e.schema_name = n.schema_name) AND (e.\"version\" = n.schema_version) AND (e.entity_name = n.entity_type)))) WHERE \"system\".main.td_schema_check_v2(s.dsl, s.ir) GROUP BY o.entity_id, o.schema_name, o.entity_type;"],["entity_presence_events","CREATE VIEW td_catalog_v1.entity_presence_events AS (SELECT e.command_id, e.entity_id, n.\"position\", e.operation, e.valid_from, e.valid_to FROM (td_catalog_v1.entity_presence_edits AS e INNER JOIN td_catalog_v1.entity_commands AS n USING (command_id, entity_id))) UNION ALL (SELECT m.command_id, m.entity_id, c.\"position\", m.operation, m.valid_from, m.valid_to FROM (((td_catalog_v1.entity_batch_members AS m INNER JOIN td_catalog_v1.entity_batches AS b USING (command_id)) INNER JOIN main.commands AS c USING (command_id)) INNER JOIN td_catalog_v1.schema_type_modes AS t ON (((t.schema_name = b.schema_name) AND (t.entity_type = m.entity_type)))) WHERE t.is_live);"],["native_catalog_integrity","CREATE VIEW td_catalog_v1.native_catalog_integrity AS WITH provenance_children AS MATERIALIZED (SELECT a.assertion_id FROM (main.assertions AS a SEMI JOIN td_catalog_v1.entity_assertion_sources AS p USING (assertion_id))) SELECT CASE  WHEN ((((SELECT count_star() FROM main.store_meta) != 1) OR (NOT ((SELECT min(\"version\") FROM main.store_meta) IN (5, 6, 8, 9, 10, 11, 12))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: invalid native store format')) WHEN ((((SELECT count_star() FROM td_catalog_v1.catalog_revision) > 1) OR EXISTS(SELECT 1 FROM td_catalog_v1.catalog_revision WHERE ((singleton IS DISTINCT FROM true) OR (revision IS NULL) OR (NOT (revision IN (2, 3))))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: unsupported native catalog revision')) WHEN ((EXISTS(SELECT 1 FROM td_catalog_v1.entity_patch_commands) AND ((NOT ((SELECT min(\"version\") FROM main.store_meta) IN (6, 8, 9, 10, 11, 12))) OR ((SELECT count_star() FROM td_catalog_v1.catalog_revision) != 1)))) THEN (\"error\"('TD_E_COMMAND_FORMAT: interval history requires an interval-capable format')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) = 6) AND ((NOT EXISTS(SELECT 1 FROM td_catalog_v1.entity_patch_commands)) OR ((SELECT count_star() FROM td_catalog_v1.catalog_revision) != 1)))) THEN (\"error\"('TD_E_COMMAND_FORMAT: native format six lacks interval history')) WHEN (((((SELECT min(\"version\") FROM main.store_meta) = 8) AND (NOT EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') = 'td.schema/2')))) OR (((SELECT min(\"version\") FROM main.store_meta) IN (5, 6)) AND EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') = 'td.schema/2'))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: expanded schema metadata differs from store format')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) < 10) AND (((SELECT min(\"version\") FROM main.store_meta) = 9) IS DISTINCT FROM (EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" AS s , json_each(s.ir, '$.entities') AS e , json_each(e.\"value\", '$.attributes') AS f WHERE (TRY_CAST(json_extract(f.\"value\", '$.tag') AS UTINYINT) IN (7, 8))) OR EXISTS(SELECT 1 FROM td_catalog_v1.catalog_revision WHERE (revision = 3)))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: format nine feature metadata differs from store format')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) < 11) AND (((SELECT min(\"version\") FROM main.store_meta) = 10) IS DISTINCT FROM EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') = 'td.schema/3'))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: format ten uniqueness metadata differs from store format')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) >= 11) IS DISTINCT FROM EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') IN ('td.schema/4', 'td.schema/5'))))) THEN (\"error\"('TD_E_COMMAND_FORMAT: format eleven presence metadata differs from store format')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) = 12) IS DISTINCT FROM EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') = 'td.schema/5')))) THEN (\"error\"('TD_E_COMMAND_FORMAT: format twelve reference coverage metadata differs from store format')) WHEN (EXISTS(SELECT 1 FROM (td_catalog_v1.\"schemas\" AS s FULL JOIN td_catalog_v1.schema_unique_activations AS u ON (((s.\"name\" = u.schema_name) AND (s.\"version\" = u.schema_version)))) WHERE ((u.command_id IS NOT NULL) IS DISTINCT FROM CASE  WHEN ((json_extract_string(s.ir, '$.format') = 'td.schema/3')) THEN (true) WHEN ((json_extract_string(s.ir, '$.format') IN ('td.schema/4', 'td.schema/5'))) THEN (EXISTS(SELECT 1 FROM json_each(s.ir, '$.entities') AS e , json_each(e.\"value\", '$.attributes') AS f WHERE (CAST(CAST(json_extract(f.\"value\", '$.unique') AS BOOLEAN) AS BOOLEAN) IS NOT DISTINCT FROM true))) ELSE false END))) THEN (\"error\"('TD_E_SCHEMA_UNIQUE_AUDIT: uniqueness activation binding is missing')) WHEN ((EXISTS(SELECT 1 FROM (td_catalog_v1.\"schemas\" AS s FULL JOIN td_catalog_v1.schema_presence_activations AS u ON (((s.\"name\" = u.schema_name) AND (s.\"version\" = u.schema_version)))) WHERE ((u.command_id IS NOT NULL) IS DISTINCT FROM COALESCE((json_extract_string(s.ir, '$.format') IN ('td.schema/4', 'td.schema/5')), false))) OR (((SELECT min(\"version\") FROM main.store_meta) < 11) AND (EXISTS(SELECT 1 FROM td_catalog_v1.entity_presence_edits) OR EXISTS(SELECT 1 FROM td_catalog_v1.schema_type_modes WHERE is_live))))) THEN (\"error\"('TD_E_OWNER_AUDIT_PRESENCE: unexpected or missing presence metadata')) WHEN (EXISTS(SELECT 1 FROM td_catalog_v1.\"schemas\" WHERE (CAST(\"system\".main.td_schema_check_v2(dsl, ir) AS BOOLEAN) IS DISTINCT FROM true))) THEN (\"error\"('TD_E_SCHEMA_CATALOG: invalid stored schema')) WHEN ((((SELECT min(\"version\") FROM main.store_meta) IN (5, 6, 8)) AND EXISTS(SELECT 1 FROM td_catalog_v1.catalog_revision WHERE (revision != 2)))) THEN (\"error\"('TD_E_COMMAND_FORMAT: legacy format/catalog revision mismatch')) WHEN ((((SELECT count_star() FROM td_catalog_v1.catalog_revision WHERE (revision = 3)) = 1) IS DISTINCT FROM EXISTS(SELECT 1 FROM td_catalog_v1.entity_batches))) THEN (\"error\"('TD_E_COMMAND_FORMAT: batch history and catalog revision differ')) WHEN (EXISTS(SELECT 1 FROM (td_catalog_v1.entity_batch_members AS m LEFT JOIN td_catalog_v1.entity_batches AS b USING (command_id)) WHERE (b.command_id IS NULL))) THEN (\"error\"('TD_E_COMMAND_HISTORY: orphan batch member')) WHEN (EXISTS(SELECT 1 FROM ((td_catalog_v1.entity_batches AS b LEFT JOIN main.commands AS c USING (command_id)) LEFT JOIN td_catalog_v1.\"schemas\" AS s ON (((s.\"name\" = b.schema_name) AND (s.\"version\" = b.schema_version)))) WHERE ((c.command_id IS NULL) OR (c.origin IS DISTINCT FROM 'triplex') OR (c.\"position\" IS NULL) OR (c.\"position\" <= 0) OR (c.\"position\" > (SELECT \"position\" FROM main.clock WHERE singleton)) OR (c.request_hash IS NULL) OR (c.receipt IS NULL) OR (s.\"name\" IS NULL) OR (s.content_hash IS DISTINCT FROM b.schema_hash) OR EXISTS(SELECT 1 FROM td_catalog_v1.entity_commands AS n WHERE (n.command_id = b.command_id)) OR (b.member_count != (SELECT count_star() FROM td_catalog_v1.entity_batch_members AS m WHERE (m.command_id = b.command_id))) OR ((b.member_count - 1) != (SELECT max(m.ordinal) FROM td_catalog_v1.entity_batch_members AS m WHERE (m.command_id = b.command_id))) OR (0 != (SELECT min(m.ordinal) FROM td_catalog_v1.entity_batch_members AS m WHERE (m.command_id = b.command_id)))))) THEN (\"error\"('TD_E_COMMAND_HISTORY: batch command binding is missing')) WHEN (EXISTS(SELECT 1 FROM (((td_catalog_v1.entity_batch_members AS m INNER JOIN td_catalog_v1.entity_batches AS b USING (command_id)) LEFT JOIN td_catalog_v1.entity_owners AS o USING (entity_id)) LEFT JOIN td_catalog_v1.entities AS e ON (((e.schema_name = b.schema_name) AND (e.\"version\" = b.schema_version) AND (e.entity_name = m.entity_type)))) WHERE ((o.schema_name IS DISTINCT FROM b.schema_name) OR (o.entity_type IS DISTINCT FROM m.entity_type) OR (e.entity_name IS NULL)))) THEN (\"error\"('TD_E_COMMAND_HISTORY: batch member binding is missing')) WHEN (EXISTS(SELECT 1 FROM ((((td_catalog_v1.entity_patch_commands AS p LEFT JOIN td_catalog_v1.entity_commands AS n USING (command_id)) LEFT JOIN main.commands AS c USING (command_id)) LEFT JOIN td_catalog_v1.\"schemas\" AS s ON (((s.\"name\" = n.schema_name) AND (s.\"version\" = n.schema_version)))) LEFT JOIN td_catalog_v1.entity_owners AS o ON ((o.entity_id = n.entity_id))) WHERE ((n.command_id IS NULL) OR (c.\"position\" IS DISTINCT FROM n.\"position\") OR (c.origin IS DISTINCT FROM 'triplex') OR (s.content_hash IS DISTINCT FROM n.schema_hash) OR (o.schema_name IS DISTINCT FROM n.schema_name) OR (o.entity_type IS DISTINCT FROM n.entity_type) OR (CAST(\"system\".main.td_schema_check_v2(s.dsl, s.ir) AS BOOLEAN) IS DISTINCT FROM true)))) THEN (\"error\"('TD_E_COMMAND_HISTORY: interval command binding is missing')) WHEN (((SELECT count_star() FROM td_catalog_v1.entity_assertion_sources) != (SELECT count_star() FROM provenance_children))) THEN (\"error\"('TD_E_COMMAND_HISTORY: orphan interval provenance')) ELSE true END AS ok;"],["schema_reference_coverage","CREATE VIEW td_catalog_v1.schema_reference_coverage AS SELECT s.\"name\" AS schema_name, s.\"version\", entity_rows.entity_value.\"name\" AS entity_type, attribute_rows.attribute_value.\"key\" AS \"attribute\", attribute_rows.attribute_value.reference AS reference_type FROM (SELECT \"name\", \"version\", json_transform(ir, '{\"entities\":[{\"name\":\"VARCHAR\",\"attributes\":[{\"key\":\"VARCHAR\",\"reference\":\"VARCHAR\",\"reference_policy\":\"VARCHAR\"}]}]}') AS definition FROM td_catalog_v1.\"schemas\" WHERE (json_extract_string(ir, '$.format') = 'td.schema/5')) AS s , unnest(s.definition.entities) AS entity_rows(entity_value) , unnest(entity_rows.entity_value.attributes) AS attribute_rows(attribute_value) WHERE (attribute_rows.attribute_value.reference_policy = 'coverage');"],["schema_references","CREATE VIEW td_catalog_v1.schema_references AS SELECT s.\"name\" AS schema_name, s.\"version\", json_extract_string(r.\"value\", '$.entity') AS entity_type, json_extract_string(r.\"value\", '$.attribute') AS \"attribute\", json_extract_string(r.\"value\", '$.target') AS reference_type FROM td_catalog_v1.\"schemas\" AS s , json_each(\"system\".main.td_schema_references_v2(s.dsl, s.ir)) AS r;"],["schema_type_declarations","CREATE VIEW td_catalog_v1.schema_type_declarations AS SELECT s.\"name\" AS schema_name, s.\"version\", json_extract_string(e.\"value\", '$.name') AS entity_type, COALESCE(CAST(json_extract(e.\"value\", '$.live') AS BOOLEAN), false) AS is_live FROM td_catalog_v1.\"schemas\" AS s , json_each(s.ir, '$.entities') AS e;"],["unique_domains","CREATE VIEW td_catalog_v1.unique_domains AS SELECT s.\"name\" AS schema_name, json_extract_string(e.\"value\", '$.name') AS entity_type, json_extract_string(a.\"value\", '$.key') AS \"attribute\", CAST(json_extract(a.\"value\", '$.tag') AS UTINYINT) AS value_tag, min(c.\"position\") AS enforced_from FROM (((main.store_meta AS m CROSS JOIN td_catalog_v1.schema_unique_activations AS u) INNER JOIN td_catalog_v1.\"schemas\" AS s ON (((s.\"name\" = u.schema_name) AND (s.\"version\" = u.schema_version)))) INNER JOIN main.commands AS c ON ((c.command_id = u.command_id))) , json_each(s.ir, '$.entities') AS e , json_each(e.\"value\", '$.attributes') AS a WHERE ((m.\"version\" IN (10, 11, 12)) AND (json_extract_string(s.ir, '$.format') IN ('td.schema/3', 'td.schema/4', 'td.schema/5')) AND (CAST(CAST(json_extract(a.\"value\", '$.unique') AS BOOLEAN) AS BOOLEAN) IS NOT DISTINCT FROM true)) GROUP BY 1, 2, 3, 4;"]]},"loadedImages":["[LOCAL_PATH_0043]","/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation","/usr/lib/libobjc.A.dylib","/System/Library/PrivateFrameworks/CoreServicesInternal.framework/Versions/A/CoreServicesInternal","/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation","/usr/lib/liboah.dylib","/usr/lib/libfakelink.dylib","/usr/lib/libicucore.A.dylib","/usr/lib/libSystem.B.dylib","/System/Library/PrivateFrameworks/SoftLinking.framework/Versions/A/SoftLinking","/usr/lib/swift/libswiftCore.dylib","/usr/lib/libc++abi.dylib","/usr/lib/libRosetta.dylib","/usr/lib/libc++.1.dylib","/usr/lib/swift/libswiftObjectiveC.dylib","/usr/lib/libswiftPrespecialized.dylib","/System/Library/Frameworks/SystemConfiguration.framework/Versions/A/SystemConfiguration","/usr/lib/libz.1.dylib","/System/Library/PrivateFrameworks/CoreAutoLayout.framework/Versions/A/CoreAutoLayout","/usr/lib/libcompression.dylib","/System/Library/Frameworks/CFNetwork.framework/Versions/A/CFNetwork","/System/Library/Frameworks/DiskArbitrat