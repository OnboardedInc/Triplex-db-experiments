      {"entityId": "card:1", "value": {"type": "string", "value": ""}, "assertionIds": ["$id:T7"], "supports": 1},
      {"entityId": "card:1", "value": {"type": "string", "value": "𐀀"}, "assertionIds": ["$id:T8"], "supports": 1}],
     "citations": ["C5.5"]}
