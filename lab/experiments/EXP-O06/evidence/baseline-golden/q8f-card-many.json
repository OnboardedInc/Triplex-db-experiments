      {"op": "assert", "label": "T5", "entityId": "card:1", "entityType": "Card", "attribute": ":card/tags", "value": {"type": "string", "value": "é", "codepoints": ["U+0065", "U+0301"]}, "validFrom": 0},
      {"op": "assert", "label": "T6", "entityId": "card:1", "entityType": "Card", "attribute": ":card/tags", "value": {"type": "string", "value": "a"}, "validFrom": 0},
      {"op": "assert", "label": "T7", "entityId": "card:1", "entityType": "Card", "attribute": ":card/tags", "value": {"type": "string", "value": "", "codepoints": ["U+E000"]}, "validFrom": 0},
      {"op": "assert", "label": "T8", "entityId": "card:1", "entityType": "Card", "attribute": ":card/tags", "value": {"type": "string", "value": "𐀀", "codepoints": ["U+10000"]}, "validFrom": 0},
      {"op": "assert", "label": "T9", "entityId": "card:1", "entityType": "Card", "attribute": ":card/tags", "value": {"type": "string", "value": ""}, "validFrom": 0},
      {"op": "assert", "label": "N1", "entityId": "card:1", "entityType": "Card", "attribute": ":card/name", "value": {"type": "string", "value": "one"}, "validFrom": 0}],
     "expect": {"outcome": "committed", "assertedCount": 10}}
   ],
   "queries": [
