      {"entityId": "card:1", "value": {"type": "string", "value": "a"}, "assertionIds": ["$id:T2", "$id:T6"], "supports": 2},
      {"entityId": "card:1", "value": {"type": "string", "value": "b"}, "assertionIds": ["$id:T1"], "supports": 1},
      {"entityId": "card:1", "value": {"type": "string", "value": "é"}, "assertionIds": ["$id:T5"], "supports": 1},
