diff --git a/packages/datomic/gateway/src/triplex/gateway/storage.clj b/packages/datomic/gateway/src/triplex/gateway/storage.clj
new file mode 100644
--- /dev/null
+++ b/packages/datomic/gateway/src/triplex/gateway/storage.clj
@@ -0,0 +1,143 @@
+(ns triplex.gateway.storage
+  (:require [datomic.api :as d] [triplex.gateway.codec :as codec])
+  (:import [java.util UUID]))
+
+;; [EXP-DA01] Why: hold an unfiltered immutable db for speculative reads. Rejected: d/with on as-of (filtered db unsupported).
+(def snapshots (atom {}))
+(def ttl-ms 120000)
+(defn begin! [name db]
+  (let [handle (str (UUID/randomUUID)) now (System/currentTimeMillis)]
+    (swap! snapshots #(assoc (into {} (filter (fn [[_ v]] (> (:expires v) now)) %)) handle
+                            {:name name :db db :expires (+ now ttl-ms)}))
+    {:handle handle :position (codec/encode-value "long" (:triplex.scope/position (d/entity db (d/q '[:find ?s . :where [?s :triplex.scope/key]] db))))}))
+(defn release! [name handle]
+  (when (= name (:name (@snapshots handle))) (swap! snapshots dissoc handle))
+  {:released true})
+(defn held-db [name handle]
+  (let [entry (@snapshots handle)]
+    (when-not (and (= name (:name entry)) (> (:expires entry 0) (System/currentTimeMillis)))
+      (throw (ex-info "Snapshot expired or belongs to another database" {:status 409 :code "SnapshotExpired"})))
+    (:db entry)))
+(defn decode-row [row] (into {} (map (fn [[k v]] [(keyword k) (when (some? v) (codec/decode-value v))]) row)))
+(def long-fields #{:recorded_position :retracted_position :schema_version})
+(defn wire-row [row]
+  (into {} (map (fn [[k v]] [(name k) (when (some? v) (codec/encode-value (cond (long-fields k) "long" (number? v) "double" :else "string") v))]) row)))
+(defn finite! [x] (when-not (and (number? x) (Double/isFinite (double x))) (codec/invalid "Expected finite double")) (double x))
+(defn safe-position [x] (when-not (and (integer? x) (<= 0 x 9007199254740991)) (codec/invalid "Unsafe position")) (long x))
+(defn upserts [rows]
+  (let [subjects (set (concat (map :entity_id rows) (keep #(when (= "ref" (:value_type %)) (:value_string %)) rows)))
+        attributes (set (map :attribute rows))]
+    (concat (map (fn [s] {:db/id (str "e:" s) :triplex.entity/id s}) subjects)
+            (map (fn [a] {:db/id (str "a:" a) :triplex.attr/key a}) attributes))))
+(defn fact-map [row]
+  (let [kind (:value_type row) subject (str "e:" (:entity_id row))
+        value (case kind
+                "string" {:f.v/string (:value_string row)}
+                "integer" {:f.v/long (codec/decode-value {"t" "long" "v" (:value_string row)})}
+                "ref" {:f.v/ref (str "e:" (:value_string row))}
+                "number" {:f.v/double (finite! (:value_number row))}
+                "datetime" {:f.v/double (finite! (:value_datetime row))}
+                "boolean" {:f.v/boolean (= 1 (:value_boolean row))}
+                "json" {:f.v/json (:value_json row)}
+                "blob" {:f.v/blob (.getBytes ^String (:value_string row) "UTF-8") :f.v/blob-meta (:value_json row)}
+                (codec/invalid "Unknown value family"))]
+    (merge {:db/id (str "f:" (:id row)) :f/id (:id row) :f/subject subject
+            :f/attr (str "a:" (:attribute row)) :f/type (keyword kind)
+            :f/valid-from (finite! (:valid_from row)) :f/schema-version (long (:schema_version row))
+            :f/recorded-at (finite! (:recorded_at row)) :f/position (safe-position (:recorded_position row))
+            :f/asserted-in "datomic.tx"}
+           (when (nil? (:retracted_at row)) {:f/live subject})
+           (when (:retracted_at row) {:f/retracted-in "datomic.tx" :f/retracted-at (finite! (:retracted_at row))
+                                      :f/retracted-position (safe-position (:retracted_position row)) :f/retract-tx-id (:retract_tx_id row)})
+           (when (:tx_id row) {:f/tx-id (:tx_id row)})
+           (when (:valid_to row) {:f/valid-to (finite! (:valid_to row))})
+           (when (:created_by row) {:f/created-by (:created_by row)})
+           (when (:entity_type row) {:f/entity-type (:entity_type row)}) value)))
+(defn tx-data [db input]
+  (let [rows (mapv decode-row (get input "rows")) new-ids (set (get input "newIds"))
+        fresh (filter #(new-ids (:id %)) rows) old (remove #(new-ids (:id %)) rows)
+        source (safe-position (get input "sourceK")) position (safe-position (get input "position"))
+        scope (d/q '[:find ?s . :where [?s :triplex.scope/key]] db)
+        claims (get input "claims")]
+    (when-not (> position source) (codec/invalid "Commit position must advance"))
+    (vec (concat [[:db/cas scope :triplex.scope/position source position]
+                  (cond-> {:db/id "datomic.tx" :triplex.tx/position position
+                           :triplex.tx/operation-id (get input "operationId")}
+                    (seq rows) (assoc :triplex.tx/id (or (:tx_id (first rows)) "")
+                                      :triplex.tx/recorded-at (finite! (:recorded_at (first rows)))))]
+                 (upserts fresh) (map fact-map fresh)
+                 (mapcat (fn [row]
+                           (let [eid (d/entid db [:f/id (:id row)]) entity (when eid (d/entity db eid))]
+                             (when-not (and eid (:f/live entity) (:retracted_at row)) (codec/invalid "Invalid retraction"))
+                             [[:db/retract eid :f/live (:db/id (:f/subject entity))]
+                              [:db/add eid :f/retracted-in "datomic.tx"]
+                              [:db/add eid :f/retracted-at (finite! (:retracted_at row))]
+                              [:db/add eid :f/retracted-position (safe-position (:retracted_position row))]
+                              [:db/add eid :f/retract-tx-id (:retract_tx_id row)]])) old)
+                 (map (fn [claim] {:db/id (str "c:" (get claim "commandId"))
+                                  :triplex.claim/command-id (get claim "commandId")
+                                  :triplex.claim/tx "datomic.tx"
+                                  :triplex.claim/tx-id (get claim "txId")}) claims)))))
+(defn commit! [conn db input]
+  (try
+    (let [report (deref (d/transact conn (tx-data db input)) 5000 ::timeout)]
+      (when (= report ::timeout) (throw (ex-info "Commit outcome unknown" {:status 503 :code "OutcomeUnknown"})))
+      {:t (codec/encode-value "long" (d/basis-t (:db-after report)))
+       :position (codec/encode-value "long" (get input "position")) :datoms (count (:tx-data report))})
+    (catch Exception e
+      (let [text (str e)]
+        (throw (ex-info (.getMessage e)
+                       {:status (if (re-find #"cas-failed|unique-conflict" text) 409 400)
+                        :code (cond (re-find #"cas-failed" text) "CasConflict"
+                                    (re-find #"triplex.claim/command-id" text) "CommandConflict"
+                                    (re-find #"triplex.tx/operation-id" text) "OperationDuplicate"
+                                    (re-find #"f/id" text) "IdentityConflict" :else "TransactionRejected")} e))))))
+(defn operation [db id]
+  (if-let [entity (d/entity db [:triplex.tx/operation-id id])]
+    (if-let [p (:triplex.tx/position entity)]
+      {:status "committed" :position (codec/encode-value "long" p) :t (codec/encode-value "long" (d/tx->t (:db/id entity)))}
+      {:status "absent"}) {:status "absent"}))
+;; [EXP-DA01] Why: AVET reconstructs P-to-t from durable tx annotations after restart. Rejected: wall-clock as-of (nonmonotonic recorded times).
+(defn at-position [db p]
+  (if (nil? p) db
+      (let [p (safe-position p) latest (d/q '[:find (max ?p) . :where [_ :triplex.tx/position ?p]] db)]
+        (cond (and latest (>= p latest)) db
+              :else (if-let [datom (first (d/datoms db :avet :triplex.tx/position p))]
+                      (d/as-of db (d/tx->t (:e datom)))
+                      (d/as-of db 0))))))
+(defn row [db eid]
+  (let [f (d/entity db eid) tx (:f/asserted-in f) rtx (:f/retracted-in f) kind (name (:f/type f))]
+    {:id (:f/id f) :entity_id (:triplex.entity/id (:f/subject f)) :attribute (:triplex.attr/key (:f/attr f))
+     :value_type kind
+     :value_string (case kind "integer" (str (:f.v/long f)) "ref" (:triplex.entity/id (:f.v/ref f))
+                         "blob" (String. ^bytes (:f.v/blob f) "UTF-8") "string" (:f.v/string f) nil)
+     :value_number (when (= kind "number") (:f.v/double f))
+     :value_datetime (when (= kind "datetime") (:f.v/double f))
+     :value_boolean (when (= kind "boolean") (if (:f.v/boolean f) 1.0 0.0))
+     :value_json (case kind "json" (:f.v/json f) "blob" (:f.v/blob-meta f) nil)
+     :recorded_at (:f/recorded-at f) :recorded_position (:f/position f)
+     :tx_id (:f/tx-id f) :valid_from (:f/valid-from f) :valid_to (:f/valid-to f)
+     :created_by (:f/created-by f) :entity_type (:f/entity-type f) :schema_version (:f/schema-version f)
+     :retracted_at (:f/retracted-at f) :retracted_position (:f/retracted-position f) :retract_tx_id (:f/retract-tx-id f)}))
+(defn visible? [row basis history]
+  (let [p (get basis "recordedPosition") r (get basis "recordedAt") v (get basis "validAt")]
+    (and (or (nil? p) (<= (:recorded_position row) p)) (or (nil? r) (<= (:recorded_at row) r))
+         (or history
+             (and (not (and (:retracted_at row) (or (nil? p) (<= (:retracted_position row) p))
+                            (or (nil? r) (<= (:retracted_at row) r))))
+                  (or (nil? v) (and (<= (:valid_from row) v) (or (nil? (:valid_to row)) (> (:valid_to row) v)))))))))
+(defn read-rows [name current input]
+  (let [basis (get input "basis") history (get input "history")
+        db (if-let [handle (get input "handle")] (held-db name handle) (at-position current (get basis "recordedPosition")))
+        pattern (get input "pattern") id (get input "id") entities (get input "entityIds")
+        ids (cond id (if-let [eid (d/entid db [:f/id id])] [eid] [])
+                  (get pattern "entityId") (if-let [subject (d/entid db [:triplex.entity/id (get pattern "entityId")])]
+                                              (map :e (d/datoms db :vaet subject :f/subject)) [])
+                  :else (map :e (d/datoms db :avet :f/id)))
+        rows (map #(row db %) ids)]
+    {:rows (mapv wire-row
+                 (filter (fn [r] (and (visible? r basis history)
+                                     (or (nil? entities) (some #{(:entity_id r)} entities))
+                                     (every? (fn [[k field]] (or (nil? (get pattern k)) (.startsWith ^String (str (get pattern k)) "?")
+                                                               (= (get pattern k) (get r field))))
+                                             [["entityId" :entity_id] ["attribute" :attribute] ["entityType" :entity_type]]))) rows))}))
diff --git a/packages/datomic/src/DatomicStorageAdapter.ts b/packages/datomic/src/DatomicStorageAdapter.ts
new file mode 100644
--- /dev/null
+++ b/packages/datomic/src/DatomicStorageAdapter.ts
@@ -0,0 +1,388 @@
+// [EXP-DA01] Why: adapt XTDB staged SPI and savepoint/replay discipline to one Datomic transaction. Rejected: per-row commits (break atomicity).
+import { randomUUID } from "node:crypto";
+import { Effect, Exit, Semaphore } from "effect";
+import { type ResolvedTemporalBasis } from "@triplex-build/triplex";
+import {
+  type StorageAdapterService,
+  type TripleRow,
+  type TripleInput,
+  type QueryPattern,
+  WriteError,
+  ReadError,
+  MigrationError,
+  TransactionOutcomeUnknown,
+} from "@triplex-build/triplex/runtime";
+import { DatomicClient, DatomicHttpError } from "./DatomicClient.js";
+import {
+  matchesPattern,
+  packValue,
+  visibleAt,
+} from "./rows.js";
+import { createHash } from "node:crypto";
+import { CurrentTransactions, type TransactionState } from "./TransactionContext.js";
+
+export class DatomicSerializationConflict extends WriteError {
+  readonly reason = "serialization-conflict" as const;
+}
+
+export const makeDatomicStorageAdapter = (
+  client: DatomicClient,
+  scopeKey: string,
+  options: {
+    readonly maxRetries?: number;
+    readonly resolutionTimeoutMs?: number;
+    readonly admissionQueue?: boolean;
+    readonly constraintStrategy?: "portable" | "inline" | "projection";
+  } = {},
+): StorageAdapterService => {
+  const key = Symbol(scopeKey);
+  const db = `s-${createHash("sha256").update(scopeKey).digest("hex").slice(0, 32)}`;
+  const maxRetries = options.maxRetries ?? 12;
+  const resolutionTimeoutMs = options.resolutionTimeoutMs ?? 30_000;
+  const admission = Semaphore.makeUnsafe(1);
+  const current = Effect.map(CurrentTransactions, (transactions) => transactions.get(key));
+  const read = <A>(thunk: (signal: AbortSignal) => Promise<A>): Effect.Effect<A, ReadError> =>
+    Effect.tryPromise({
+      try: thunk,
+      catch: (cause) => new ReadError({ message: "Datomic read failed", cause }),
+    });
+  const committedPosition = () =>
+    read(async () => {
+      const result = await client.basis(db);
+      const position = Number(result.position.v);
+      if (!Number.isSafeInteger(position) || position < 0) throw new RangeError("Unsafe position");
+      return position;
+    });
+  const requireTransaction = Effect.flatMap(current, (state) =>
+    state === undefined
+      ? Effect.fail(new WriteError({ message: "Datomic mutation requires withTransaction" }))
+      : Effect.succeed(state),
+  );
+
+  const queryRows = (
+    pattern: QueryPattern,
+    basis?: ResolvedTemporalBasis,
+    history = false,
+    id?: string,
+    entityIds?: readonly string[],
+  ): Effect.Effect<readonly TripleRow[], ReadError> =>
+    Effect.gen(function* () {
+      const state = yield* current;
+      const position =
+        state === undefined
+          ? basis?.recordedPosition
+          : Math.min(state.sourceK, basis?.recordedPosition ?? state.sourceK);
+      const rows = yield* read(() => client.rows(db, {
+        pattern, history,
+        ...(id === undefined ? {} : { id }),
+        ...(entityIds === undefined ? {} : { entityIds }),
+        ...(basis === undefined ? {} : { basis: { ...basis, ...(position === undefined ? {} : { recordedPosition: position }) } }),
+        ...(state === undefined ? {} : { handle: state.handle }),
+      }));
+      const byId = new Map(rows.map((row) => [row.id, row]));
+      if (state !== undefined) {
+        for (const [rowId, row] of state.rows) {
+          byId.delete(rowId);
+          if (
+            (id === undefined || rowId === id) &&
+            (entityIds === undefined || entityIds.includes(row.entity_id)) &&
+            matchesPattern(row, pattern) &&
+            (history || visibleAt(row, basis))
+          )
+            byId.set(rowId, row);
+        }
+      }
+      return [...byId.values()].sort(
+        (left, right) => left.recorded_at - right.recorded_at || left.id.localeCompare(right.id),
+      );
+    });
+
+  const persist = (
+    state: TransactionState,
+    operationId: string,
+    attemptId: string,
+  ): Effect.Effect<void, WriteError> => {
+    return Effect.tryPromise({
+      try: async () => {
+        const until = Date.now() + resolutionTimeoutMs;
+        const bounded = async <A>(promise: Promise<A>): Promise<A> => {
+          let timer: ReturnType<typeof setTimeout> | undefined;
+          try {
+            return await Promise.race([
+              promise,
+              new Promise<never>((_resolve, reject) => {
+                timer = setTimeout(
+                  () => reject(new Error("Datomic outcome resolution deadline exceeded")),
+                  Math.max(0, until - Date.now()),
+                );
+              }),
+            ]);
+          } finally {
+            if (timer !== undefined) clearTimeout(timer);
+          }
+        };
+        let submitError: unknown;
+        try {
+          await bounded(client.transact(db, { sourceK: state.sourceK, position: state.position, operationId, attemptId, rows: [...state.rows.values()], newIds: [...state.newIds], claims: [...state.claims.values()] }));
+        } catch (error) {
+          if (error instanceof DatomicHttpError && error.status === 409 && error.code !== "OperationDuplicate") {
+            if (["CasConflict", "CommandConflict"].includes(error.code))
+              throw new DatomicSerializationConflict({
+                message: "Datomic source changed while staging the transaction",
+                cause: error,
+              });
+            throw new WriteError({ message: "Datomic transaction was rejected", cause: error });
+          }
+          submitError = error;
+        }
+        do {
+          try {
+            const receipt = await bounded(
+              client.operation(db, operationId),
+            );
+            if (receipt.status === "committed") return;
+          } catch (error) {
+            submitError = error;
+          }
+          if (Date.now() >= until) break;
+          await new Promise((resolve) => setTimeout(resolve, 25));
+        } while (true);
+        throw new TransactionOutcomeUnknown({
+          operationId,
+          attemptId,
+          ...(state.claims.size === 1 ? { commandId: [...state.claims.keys()][0]! } : {}),
+          ...(submitError === undefined ? {} : { cause: submitError }),
+        });
+      },
+      catch: (cause) =>
+        cause instanceof WriteError
+          ? cause
+          : new WriteError({ message: "Datomic transaction failed", cause }),
+    });
+  };
+
+  const withTransaction = <A, E>(
+    effect: Effect.Effect<A, E>,
+    transactionOptions?: { readonly replaySafe?: boolean },
+  ): Effect.Effect<A, E | WriteError> =>
+    Effect.suspend(() => {
+      const operationId = randomUUID();
+      const attempt = (retry: number): Effect.Effect<A, E | WriteError> =>
+        Effect.gen(function* () {
+          const transactions = yield* CurrentTransactions;
+          const parent = transactions.get(key);
+          if (parent !== undefined) {
+            const baseline = {
+              position: parent.position,
+              rows: new Map(parent.rows),
+              claims: new Map(parent.claims),
+              newIds: new Set(parent.newIds),
+            };
+            const child: TransactionState = {
+              client,
+              scopeKey,
+              sourceK: parent.sourceK,
+              handle: parent.handle,
+              ...baseline,
+              rows: new Map(baseline.rows),
+              claims: new Map(baseline.claims),
+              newIds: new Set(baseline.newIds),
+            };
+            const context = new Map(transactions);
+            context.set(key, child);
+            const result = yield* Effect.provideService(effect, CurrentTransactions, context);
+            // A failed child never mutates the parent. A successful child cannot
+            // overwrite a sibling's intervening writes or allocated positions.
+            const unchanged = <K, V>(left: ReadonlyMap<K, V>, right: ReadonlyMap<K, V>) =>
+              left.size === right.size && [...left].every(([id, value]) => right.get(id) === value);
+            if (
+              parent.position !== baseline.position ||
+              !unchanged(parent.rows, baseline.rows) ||
+              !unchanged(parent.claims, baseline.claims) ||
+              parent.newIds.size !== baseline.newIds.size ||
+              [...parent.newIds].some((id) => !baseline.newIds.has(id))
+            ) {
+              return yield* Effect.fail(
+                new DatomicSerializationConflict({
+                  message:
+                    "Concurrent nested Datomic callbacks changed the savepoint; callback was not replayed",
+                }),
+              );
+            }
+            parent.position = child.position;
+            parent.rows = child.rows;
+            parent.claims = child.claims;
+            parent.newIds = child.newIds;
+            return result;
+          }
+          const snapshot = yield* read(() => client.begin(db)).pipe(Effect.mapError(cause => new WriteError({ message: "Cannot acquire Datomic source cut", cause })));
+          const sourceK = snapshot.position;
+          const state: TransactionState = {
+            client,
+            scopeKey,
+            sourceK,
+            handle: snapshot.handle,
+            position: sourceK,
+            rows: new Map(),
+            claims: new Map(),
+            newIds: new Set(),
+          };
+          const context = new Map(transactions);
+          context.set(key, state);
+          return yield* Effect.gen(function* () {
+          const result = yield* Effect.provideService(effect, CurrentTransactions, context);
+          if (state.rows.size === 0 && state.claims.size === 0 && state.position === state.sourceK)
+            return result;
+          const exit = yield* Effect.exit(
+            Effect.uninterruptible(persist(state, operationId, randomUUID())),
+          );
+          if (Exit.isSuccess(exit)) return result;
+          return yield* Effect.failCause(exit.cause).pipe(
+            Effect.catch((error) =>
+              error instanceof DatomicSerializationConflict &&
+              transactionOptions?.replaySafe === true &&
+              retry < maxRetries
+                ? Effect.andThen(
+                    Effect.sleep(`${Math.min(50, retry * 2)} millis`),
+                    attempt(retry + 1),
+                  )
+                : Effect.fail(error),
+            ),
+          );
+          }).pipe(Effect.ensuring(Effect.promise(() => client.release(db, snapshot.handle)).pipe(Effect.ignore)));
+
+        });
+      return Effect.flatMap(current, (parent) =>
+        parent !== undefined || options.admissionQueue !== true
+          ? attempt(0)
+          : Semaphore.withPermits(admission, 1)(attempt(0)),
+      );
+    });
+
+  const insert: StorageAdapterService["insert"] = (input, txId, timestamp, id, position) =>
+    Effect.gen(function* () {
+      const state = yield* requireTransaction;
+      return yield* Effect.try({
+        try: () => {
+          const row: TripleRow = {
+            id,
+            entity_id: input.entityId,
+            attribute: input.attribute,
+            ...packValue(input.value),
+            recorded_at: timestamp,
+            recorded_position: position,
+            valid_from: input.validFrom ?? timestamp,
+            valid_to: input.validTo ?? null,
+            created_by: input.createdBy ?? null,
+            retracted_at: null,
+            retracted_position: null,
+            retract_tx_id: null,
+            entity_type: input.entityType ?? null,
+            schema_version: 1,
+            tx_id: txId,
+          };
+          if (state.rows.has(id)) throw new Error(`Duplicate assertion identity ${id}`);
+          state.rows.set(id, row);
+          state.newIds.add(id);
+          return row;
+        },
+        catch: (cause) => new WriteError({ message: "Invalid Datomic assertion", cause }),
+      });
+    });
+
+  const adapter: StorageAdapterService = {
+    supportedValueTypes: [
+      "string",
+      "number",
+      "integer",
+      "boolean",
+      "datetime",
+      "ref",
+      "json",
+      "blob",
+    ],
+    withTransaction,
+    nextCommitPosition: () =>
+      Effect.flatMap(requireTransaction, (state) =>
+        Effect.try({
+          try: () => {
+            if (!Number.isSafeInteger(state.position + 1))
+              throw new RangeError("Commit position exhausted");
+            return ++state.position;
+          },
+          catch: (cause) => new WriteError({ message: "Cannot allocate commit position", cause }),
+        }),
+      ),
+    currentCommitPosition: () =>
+      Effect.flatMap(current, (state) =>
+        state === undefined ? committedPosition() : Effect.succeed(state.position),
+      ),
+    claimCommand: (commandId, txId, timestamp) =>
+      Effect.gen(function* () {
+        const state = yield* requireTransaction;
+        const pending = state.claims.get(commandId);
+        if (pending !== undefined) return pending.txId;
+        const existing = yield* read(() => client.claim(db, commandId, state.sourceK)).pipe(Effect.mapError(cause => new WriteError({ message: "Cannot read command claim", cause })));
+        if (existing !== null) return existing;
+        state.claims.set(commandId, { commandId, txId, timestamp });
+        return null;
+      }),
+    insert,
+    batchInsert: (inputs, txId, timestamp, ids, position) =>
+      inputs.length !== ids.length
+        ? Effect.fail(new WriteError({ message: "Batch assertion identity count mismatch" }))
+        : Effect.forEach(inputs, (input: TripleInput, i) =>
+            insert(input, txId, timestamp, ids[i]!, position),
+          ),
+    retract: (id, timestamp, txId, position) =>
+      Effect.gen(function* () {
+        const state = yield* requireTransaction;
+        const row = (yield* queryRows({}, undefined, false, id).pipe(
+          Effect.mapError(
+            (cause) => new WriteError({ message: "Cannot read retraction target", cause }),
+          ),
+        ))[0];
+        if (row === undefined) return false;
+        state.rows.set(id, {
+          ...row,
+          retracted_at: timestamp,
+          retracted_position: position,
+          retract_tx_id: txId,
+        });
+        return true;
+      }),
+    getById: (id) => Effect.map(queryRows({}, undefined, false, id), (rows) => rows[0] ?? null),
+    getByEntity: (entityId, basis) => queryRows({ entityId }, basis),
+    getByEntities: (entityIds, basis) =>
+      entityIds.length === 0
+        ? Effect.succeed(new Map())
+        : Effect.map(
+            queryRows({}, basis, false, undefined, [...new Set(entityIds)]),
+            (rows) =>
+              new Map(
+                [...new Set(entityIds)].map(
+                  (entityId) =>
+                    [entityId, rows.filter((row) => row.entity_id === entityId)] as const,
+                ),
+              ),
+          ),
+    query: (pattern, basis) => queryRows(pattern, basis),
+    history: (entityId) => queryRows({ entityId }, undefined, true),
+    dependencyState: (attributes, basis) => Effect.gen(function* () {
+      const rows = (yield* queryRows({}, undefined, true)).filter(row => attributes.includes(row.attribute));
+      let sourcePosition = 0;
+      let nextTemporalBoundary: number | undefined;
+      for (const row of rows) {
+        if ((basis.recordedPosition !== undefined && row.recorded_position > basis.recordedPosition) || (basis.recordedAt !== undefined && row.recorded_at > basis.recordedAt)) continue;
+        sourcePosition = Math.max(sourcePosition, row.recorded_position);
+        if (row.retracted_position !== null && (basis.recordedPosition === undefined || row.retracted_position <= basis.recordedPosition) && (basis.recordedAt === undefined || row.retracted_at! <= basis.recordedAt)) sourcePosition = Math.max(sourcePosition, row.retracted_position);
+        if (visibleAt(row, { ...basis, validAt: row.valid_from })) for (const edge of [row.valid_from, row.valid_to]) if (edge !== null && edge > basis.validAt && (nextTemporalBoundary === undefined || edge < nextTemporalBoundary)) nextTemporalBoundary = edge;
+      }
+      return { sourcePosition, ...(nextTemporalBoundary === undefined ? {} : { nextTemporalBoundary }) };
+    }),
+    initialize: () => Effect.tryPromise({ try: async () => { await client.create(scopeKey); }, catch: cause => new MigrationError({ version: 1, name: "datomic-baseline", message: "Cannot initialize Datomic scope", cause }) }),
+    // The runtime's scoped layer owns the shared client.
+    close: () => Effect.void,
+  };
+  return adapter;
+};
