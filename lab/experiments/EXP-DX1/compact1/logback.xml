<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{ISO8601} %logger %msg%n</pattern></encoder>
  </appender>
  <logger name="datomic.transaction" level="INFO"/>
  <logger name="datomic.update" level="INFO"/>
  <logger name="datomic.log" level="INFO"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
