# Queue for ha1/first-offer-dry-run.sh: one launcher per line, NAME then the exact command of its queued unit.
# Run from the build checkout as root with the unit's environment (DX_V01_BUILD_RECEIPT, PATH with the build's tools).
# HELD is the held directory given on the command line; LOGS is the new log directory. Each launcher stops before its
# first offer and removes its own stack; outputs, copies and WAL subdirectories go under $LOGS and are deleted after.
# Fill the $VARIABLES from the queued units (bench3-*.sh); never put server addresses in this file.
cold bash lab/experiments/EXP-DX1/jvm1/cold-server.sh "$COMMIT" "$LOGS/cold-out" "$SCALE1_IMAGE_DIR" "$SCALE1_IMAGE_SHA256" "$SCALE1_TRANSFER_SHA256" "$HELD" "$HELD_CONTROL_SHA256" "$WAL_MOUNT" --credit-mode rolling6
realistic "$NODE22" --no-warnings --experimental-transform-types lab/experiments/EXP-DX1/real1/server.ts extend --commit "$COMMIT" --profile first --seed "$SCALE1_IMAGE_DIR" --image-sha256 "$SCALE1_IMAGE_SHA256" --transfer-sha256 "$SCALE1_TRANSFER_SHA256" --pgdata-source "$HELD" --pgdata-sha256 "$HELD_TREE_SHA256" --pgdata "$LOGS/real1-data/pgdata" --out "$LOGS/real1-out"
publish cp -a --reflink=never "$HELD" "$LOGS/publish-copy" && rm -rf "$LOGS/publish-copy/pg_wal" && ln -s /wal "$LOGS/publish-copy/pg_wal" && mkdir "$WAL_MOUNT/publish-dry" && cp -a "$HELD/pg_wal/." "$WAL_MOUNT/publish-dry/" && bash lab/experiments/EXP-DX1/actv-lazy/join/held-server.sh "$COMMIT" "$SCALE1_IMAGE_DIR" "$SCALE1_IMAGE_SHA256" "$SCALE1_TRANSFER_SHA256" "$HELD" "$LOGS/publish-copy" "$WAL_MOUNT/publish-dry" "$LOGS/publish-out"
reads cp -a --reflink=never "$HELD" "$LOGS/reads-copy" && node lab/bin/scorecard.mjs --commit "$COMMIT" --age fresh --seed "$SCALE1_IMAGE_DIR" --image-sha256 "$SCALE1_IMAGE_SHA256" --transfer-sha256 "$SCALE1_TRANSFER_SHA256" --out "$LOGS/reads-out" --read-study --tx-jvm j25-zgc --wal-directory "$WAL_MOUNT" --ladder control --pgdata-source "$HELD" --pgdata "$LOGS/reads-copy"
retirement cp -a --reflink=never "$HELD" "$LOGS/retire-copy" && env DX_W1_RETIREMENT_PAIR=1 TX2_SUBJECT_APPEND_RETIREMENT=1 PREP1_LOOKUP_EVERY=64 DX_RD1_LADDER=reference DX_RD1_PGDATA_SOURCE="$HELD" DX_RD1_PGDATA="$LOGS/retire-copy" bash lab/experiments/EXP-DX1/v01/study-server.sh "$COMMIT" "$LOGS/retire-out/campaign" "$(( $(date +%s%3N) + 40*60000 ))" "$SCALE1_IMAGE_DIR" "$SCALE1_IMAGE_SHA256" "$SCALE1_TRANSFER_SHA256" fresh per-person-ordered j21-g1 "" "" "" "" j25-zgc "$WAL_MOUNT" j21-g1 rolling6
