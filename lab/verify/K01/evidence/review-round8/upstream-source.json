          "text": "        private val FLOATS = setOf(Float4, Float8)"
        },
        {
          "line": 1011,
          "text": "        private val INT_ARRAYS = setOf(Int4s, Int8s)"
        },
        {
          "line": 1012,
          "text": ""
        },
        {
          "line": 1013,
          "text": "        private fun unifyPgTypes(pgTypes: Set<PgType>): PgType = when {"
        },
        {
          "line": 1014,
          "text": "            pgTypes.isEmpty() -> Null"
        },
        {
          "line": 1015,
          "text": "            pgTypes.size == 1 -> pgTypes.first()"
        },
        {
          "line": 1016,
          "text": "            pgTypes.all { it in INTS } -> Int8"
        },
        {
          "line": 1017,
          "text": "            pgTypes.all { it in FLOATS } -> Float8"
        },
        {
          "line": 1018,
          "text": "            pgTypes.all { it in INT_ARRAYS } -> Int8s"
        },
        {
          "line": 1019,
          "text": "            else -> Default"
        },
        {
          "line": 1020,
          "text": "        }"
        },
        {
          "line": 1021,
          "text": ""
        },
        {
          "line": 1022,
          "text": "        @JvmStatic"
        },
        {
          "line": 1023,
          "text": "        fun fromVectorType(type: VectorType): PgType {"
        },
        {
          "line": 1024,
          "text": "            val pgTypes = type.legs.mapTo(mutableSetOf()) { fromXtType(it) }.minus(Null)"
        },
        {
          "line": 1025,
          "text": "            return unifyPgTypes(pgTypes)"
        },
        {
          "line": 1026,
          "text": "        }"
        },
