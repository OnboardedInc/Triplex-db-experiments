   490	/** Read-only git access; blob hashes are sha256 of the blob bytes, cached per commit:path. Failures return null. */
   491	export function gitSource(repo) {
   492	  const run = (args, input) => execFileSync('git', ['--literal-pathspecs', ...args], { cwd: repo, input, maxBuffer: 1 << 30, stdio: ['pipe', 'pipe', 'pipe'] });
   493	  const cache = new Map();
   494	  const api = {
   495	    resolve(rev) { if (!str(rev) || rev.startsWith('-')) return null; try { return run(['rev-parse', '--verify', '--quiet', `${rev}^{commit}`]).toString().trim() || null; } catch { return null; } },
   496	    treeOf(commit) { return run(['rev-parse', `${commit}^{tree}`]).toString().trim(); },
   497	    commitTime(commit) { return Number(run(['show', '-s', '--format=%ct', commit]).toString().trim()); },
   498	    /** The commit's tracked tree as a tar stream (the fresh checkout qualify builds from; Q55a step 1). */
   499	    archive(commit) { return COMMIT.test(commit) ? run(['archive', '--format=tar', commit]) : null; },
   500	    blob(rev, file) {
   501	      if (!safePath(file)) return null;
   502	      const key = COMMIT.test(rev) ? `blob:${rev}:${file}` : null; // only full commit ids are immutable
   503	      if (key && cache.has(key)) return cache.get(key);
   504	      let bytes = null;
   505	      try { bytes = run(['cat-file', 'blob', `${rev}:${file}`]); } catch { bytes = null; }
   506	      if (key) cache.set(key, bytes);
   507	      return bytes;
   508	    },
   509	    /** Tracked files (blobs) under the given roots (null: the whole tree), sorted; null when a root is unsafe or git fails. */
   510	    list(commit, roots) { const e = api.entries(commit, roots); return e && e.map(x => x.path); },
   511	    /** As list, with each blob's mode (120000 is a symlink, whose bytes are the link text, not the file a build reads). */
   512	    entries(commit, roots) {
   513	      if (roots !== null && (!Array.isArray(roots) || !roots.length || !roots.every(safePath))) return null;
   514	      const key = COMMIT.test(commit) ? `list:${commit}:${JSON.stringify(roots)}` : null;
   515	      if (key && cache.has(key)) return cache.get(key);
   516	      let result;
   517	      try {
   518	        const out = run(['ls-tree', '-r', '-z', commit, ...(roots ? ['--', ...roots] : [])]).toString('utf8');
   519	        result = out.split('\0').filter(Boolean).map(line => { const tab = line.indexOf('\t'); const [mode, type] = line.slice(0, tab).split(' '); return { mode, type, path: line.slice(tab + 1) }; })
   520	          .filter(e => e.type === 'blob').map(({ mode, path: p }) => ({ mode, path: p })).sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
   521	      } catch { result = null; }
   522	      if (key) cache.set(key, result);
   523	      return result;
   524	    },
   525	    /** Map path -> sha256 of the blob at commit; null when absent, not a file or unsafe (one cat-file --batch call). */
   526	    blobHashes(commit, files) {
   527	      const list = (Array.isArray(files) ? files : []).filter(f => typeof f === 'string');
   528	      const want = [...new Set(list)].filter(f => !cache.has(`${commit}:${f}`));
   529	      for (const f of want.filter(f => !safePath(f))) cache.set(`${commit}:${f}`, null);
   530	      const ok = want.filter(safePath);
   531	      if (ok.length) {
   532	        let out;
   533	        try { out = run(['cat-file', '--batch'], ok.map(f => `${commit}:${f}\n`).join('')); } catch { out = null; }
   534	        let at = 0;
   535	        for (const f of ok) {
   536	          if (!out) { cache.set(`${commit}:${f}`, null); continue; }
   537	          const nl = out.indexOf(10, at);
   538	          const header = out.subarray(at, nl).toString('utf8');
   539	          at = nl + 1;
   540	          // A found object's header is exactly "<oid> <type> <size>"; anything else ("<name> missing", "ambiguous") has no body.
   541	          const m = /^([0-9a-f]{40}|[0-9a-f]{64}) (\w+) (\d+)$/.exec(header);
   542	          if (!m) { cache.set(`${commit}:${f}`, null); continue; }
   543	          const size = Number(m[3]);
   544	          cache.set(`${commit}:${f}`, m[2] === 'blob' ? sha256(out.subarray(at, at + size)) : null);
   545	          at += size + 1;
   546	        }
   547	      }
   548	      return new Map(list.map(f => [f, cache.get(`${commit}:${f}`) ?? null]));
   549	    },
   550	  };
   551	  return api;
   552	}
   553	
   554	/** Content-addressed store reader: an object counts only if runs/objects/<sha> exists and its bytes hash to <sha>. */
   555	export function objectStore(dir) {
   556	  const memo = new Map();
   557	  return storeFrom(h => { if (!memo.has(h)) { const file = path.join(dir, h); memo.set(h, fs.existsSync(file) ? fs.readFileSync(file) : null); } return memo.get(h); });
   558	}
   559	/** A store over any byte lookup (a directory, or the dict the contract's fixtures use). */
   560	export function storeFrom(lookup) {
   561	  const get = h => {
   562	    if (!sha(h)) return { ok: false, why: `not a sha256: ${JSON.stringify(h)?.slice(0, 80)}` };
   563	    const bytes = lookup(h);
   564	    if (!bytes) return { ok: false, why: `object ${h} is not in the store` };
   565	    const actual = sha256(bytes);
   566	    return actual === h ? { ok: true, bytes } : { ok: false, why: `object ${h} hashes to ${actual}` };
   567	  };
   568	  return { get, json(h) { const o = get(h); if (!o.ok) return o; try { const v = parseJson(o.bytes); return isObj(v) ? { ok: true, value: v } : { ok: false, why: 'not a JSON object' }; } catch { return { ok: false, why: 'not JSON' }; } } };
   569	}
   570	
   571	// ================================================================ layer 2: the lab evaluator
   572	
   573	/**
   574	 * The run binding. The harness computes it when the run starts and writes it into the run ledger. Every inline receipt field
   575	 * that decides a role or an eligibility is in it. verifierObjectSha256 is not: the verifier writes it after the run.
   576	 */
   577	export function bindingOf(r) {
   578	  const pick = k => own(r, k);
   579	  const pid = isObj(own(r, 'profileIdentity')) ? Object.fromEntries(Object.entries(r.profileIdentity).filter(([k]) => k !== 'buildProvenanceSha256')) : own(r, 'profileIdentity');
   580	  return sha256(canonText({ ...Object.fromEntries(['receiptId', 'runKind', 'profile', 'role', 'obligation', 'definitionSha256', 'sourceTreeSha256', 'composition', 'commit',
   581	    'producedAt', 'workload', 'contract', 'endpoint', 'admission', 'producer', 'buildManifestSha256', 'executedBinarySha256'].map(k => [k, pick(k)])), profileIdentity: pid }));
   582	}
   583	
   584	/**
   585	 * Judge a claim's documents. env = { git: gitSource(repo), objects: objectStore(dir), authorityRef }.
   586	 * Returns { verdict: 'DIAGNOSTIC', documentVerdict: 'QUALIFIED' | 'DIAGNOSTIC', reasons: [{code, detail, receipt?}] }.
   587	 * The verdict is DIAGNOSTIC for every input (RULINGS Q55a: records a claimant supplies are diagnostic evidence only);
   588	 * documentVerdict is what the document checks found, and is QUALIFIED only when none of them found a reason.
   589	 */
   590	export function admitClaim(claim, env) {
   591	  const reasons = [];
   592	  const why = (code, detail, receipt) => reasons.push(receipt ? { code, detail, receipt } : { code, detail });
   593	  try { evaluate(claim, env, why); } catch (error) { why('EVALUATOR-ERROR', `evaluation stopped: ${error?.message ?? error} (fail closed)`); }
   594	  return { verdict: 'DIAGNOSTIC', documentVerdict: reasons.length ? 'DIAGNOSTIC' : 'QUALIFIED',
   595	    reasons: [{ code: 'DOCUMENT-ONLY', detail: 'a claim\'s supplied receipts and records are diagnostic evidence only; QUALIFIED comes only from claim.mjs qualify, a run the evaluator executes itself (RULINGS Q55a; Codex round 7 findings 1 and 2)' }, ...summarise(reasons)] };
   596	}
   597	
   598	function evaluate(claim, env, why) {
   599	  const { git, objects } = env;
   600	  const authorityRef = env.authorityRef ?? 'main';
   601	  if (!isObj(claim) || claim.format !== FORMATS.claim) return why('CLAIM-FORMAT', `claim format must be ${FORMATS.claim}`);
   602	  if (!['comparative', 'promotion'].includes(claim.kind)) why('CLAIM-KIND', 'kind must be comparative or promotion');
   603	  const commit = str(claim.commit) && COMMIT.test(claim.commit) ? git.resolve(claim.commit) : null;
   604	  if (!commit || commit !== claim.commit) return why('CLAIM-COMMIT', `commit ${JSON.stringify(claim.commit)} is not a full commit id in this repository`);
   605	  const label = c => sourceTreeIdOf(git.treeOf(c));
   606	  const claimLabel = label(commit);
   607	  const closureTime = git.commitTime(commit); // dependencyClosureChangedAt: no file at the claimed commit changed after it was committed
   608	
   609	  // -- the contract: the authority ref's, never the claimed commit's or the working tree's (VA6, RULINGS Q61a). Why: pins,
   610	  // definitions, schemas and the A0 and verifier registries decide admission; a branch or a working copy must not supply its
   611	  // own, and a claimed commit's own contract can never hold the registry entry that verifies it.
   612	  const authority = git.resolve(authorityRef);
   613	  if (!authority) return why('CONTRACT-AUTHORITY', `authority ref ${authorityRef} does not resolve`);
   614	  const contractBytes = git.blob(authority, PATHS.contract), loadBytes = git.blob(authority, PATHS.loadContract);
   615	  if (!contractBytes || !loadBytes) return why('CONTRACT-MISSING', `${PATHS.contract} or ${PATHS.loadContract} is missing at ${authorityRef}`);
   616	  const contract = JSON.parse(contractBytes.toString('utf8'));
   617	  const loadContract = JSON.parse(loadBytes.toString('utf8'));
   618	  const slots = (() => { const b = git.blob(authority, PATHS.slots); try { return b ? JSON.parse(b.toString('utf8')) : null; } catch { return null; } })();
   619	  const ctx = coreContext(contract, {}, loadContract);
   620	

