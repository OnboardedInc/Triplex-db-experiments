     1	/**
     2	 * Typed read failures for the broker composition (V-P2Q findings C1, C2, M2, M3; RULINGS Q58a, Q62a).
     3	 *
     4	 * Both keep ReadError's tag, as TransactionOutcomeUnknown keeps WriteError's, so every adapter and executor
     5	 * signature (`Effect<..., ReadError>`) stays unchanged; callers branch on `reason` or `instanceof`.
     6	 * - BasisNotAvailable: the surface waited within its deadline and the source (the replica's real marker, or the
     7	 *   broker's resolved prefix) did not reach the required basis. Nothing was answered.
     8	 * - ReplicaUnavailable: the replica could not be reached and the surface has no exact fallback (Datalog,
     9	 *   dependencyState, native SPARQL). Repository pulls do not raise it: they fall back to the broker's log.
    10	 */
    11	import { ReadError } from "@triplex-build/triplex/runtime";
    12	import { QleverHttpError } from "../QleverClient.js";
    13	
    14	export type BasisSurface = "repository" | "datalog" | "dependency-state" | "native" | "a0-repository";
    15	
    16	export class BasisNotAvailable extends ReadError {
    17	  readonly reason = "basis-not-available" as const;
    18	  readonly required: number;
    19	  readonly observed: number;
    20	  readonly replica: string;
    21	  readonly surface: BasisSurface;
    22	  readonly waitedMs: number;
    23	  constructor(input: {
    24	    readonly required: number;
    25	    readonly observed: number;
    26	    readonly replica: string;
    27	    readonly surface: BasisSurface;
    28	    readonly waitedMs: number;
    29	    readonly cause?: unknown;
    30	  }) {
    31	    super({
    32	      message: `Basis ${input.required} is not available on ${input.replica} for ${input.surface} reads (observed ${input.observed} after ${Math.round(input.waitedMs)} ms)`,
    33	      ...(input.cause === undefined ? {} : { cause: input.cause }),
    34	    });
    35	    this.required = input.required;
    36	    this.observed = input.observed;
    37	    this.replica = input.replica;
    38	    this.surface = input.surface;
    39	    this.waitedMs = input.waitedMs;
    40	  }
    41	}
    42	
    43	export class ReplicaUnavailable extends ReadError {
    44	  readonly reason = "replica-unavailable" as const;
    45	  readonly replica: string;
    46	  readonly surface: BasisSurface;
    47	  constructor(input: { readonly replica: string; readonly surface: BasisSurface; readonly cause?: unknown }) {
    48	    super({
    49	      message: `QLever replica ${input.replica} is unreachable for ${input.surface} reads: ${String(input.cause)}`,
    50	      ...(input.cause === undefined ? {} : { cause: input.cause }),
    51	    });
    52	    this.replica = input.replica;
    53	    this.surface = input.surface;
    54	  }
    55	}
    56	
    57	/**
    58	 * Whether a client failure means "the replica cannot be reached" (connection refused or reset, socket hang up,
    59	 * a request deadline, an aborted request, an HTTP 5xx) rather than a bad query (HTTP 4xx, a decode error).
    60	 */
    61	export const isUnreachable = (error: unknown): boolean => {
    62	  if (error instanceof QleverHttpError) return error.status >= 500;
    63	  const text = `${(error as { code?: string })?.code ?? ""} ${String((error as Error)?.message ?? error)}`;
    64	  return /ECONNREFUSED|ECONNRESET|EPIPE|ETIMEDOUT|EHOSTUNREACH|ENOTFOUND|socket hang up|deadline|aborted|timed? ?out|fetch failed|connect/i.test(
    65	    text,
    66	  );
    67	};

