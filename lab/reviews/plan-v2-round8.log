   474	    const mine = rs.filter(r => own(r, 'role') === 'measurement' && own(r, 'obligation') === o.id);
   475	    const ownOk = mine.filter(r => evidenceOk(r, o, tree, comp, commit, env, ctx) === null && wlOk(r.workload, comp));
