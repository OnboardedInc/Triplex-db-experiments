   442	/**
   443	 * The document check (contract 0.3.7's admit_claim over supplied receipts, with 0.3.9's fields): env = { store,
   444	 * dependencyClosureChangedAt }. Every reason is collected. Additions since 0.3.7: the A0 entry's measuredBy is accepted in
   445	 * VERIFIER_REGISTRY (kind a0, Q61k), workload and control apply to CR-NS and CR-GS only (Q61g), and the control's executed binary must be the A0
   446	 * registry's binarySha256 (Codex round 7 finding 2), the claimed obligation must be accepted in VERIFIER_REGISTRY at the
   447	 * claimed commit, and oracle and W0 acceptance goes through VERIFIER_REGISTRY (contractBlockers).
   448	 */
   449	export function documentCore(claim, env, ctx) {
   450	  const reasons = [];
   451	  const why = (code, detail) => reasons.push({ code, detail });
   452	  const done = () => ({ verdict: reasons.length ? 'DIAGNOSTIC' : 'QUALIFIED', reasons });
   453	  const ids = Array.isArray(own(claim, 'obligations')) ? claim.obligations : [];
   454	  if (!ids.length) { why('CLAIM-NO-OBLIGATIONS', 'the claim names no obligation'); return done(); }
   455	  const unknown = ids.filter(i => typeof i !== 'string' || !ctx.byId.has(i));
   456	  if (unknown.length) { why('UNKNOWN-OBLIGATION', `unknown obligation ids ${JSON.stringify(unknown)} are rejected, never dropped (RULINGS Q42a)`); return done(); }
   457	  const claimed = ids.map(i => ctx.byId.get(i));
   458	  const tree = claim.sourceTreeSha256, comp = isObj(claim.composition) ? claim.composition : {}, commit = claim.commit, rs = Array.isArray(claim.receipts) ? claim.receipts : [];
   459	  const domain = claimed.some(o => o.oracles.includes('O-DOMAIN'));
   460	  const prereq = [PREREQ.position, PREREQ.identity, ...(domain ? [PREREQ.w0] : [])];
   461	  for (const pid of prereq) {
   462	    const o = ctx.byId.get(pid);
   463	    const tries = rs.filter(r => own(r, 'obligation') === pid).map(r => evidenceOk(r, o, tree, comp, commit, env, ctx));
   464	    if (!tries.some(t => t === null)) why('PREREQ-MISSING', `no valid ${pid} receipt for the claim's tree and composition${tries.length ? `: ${[...new Set(tries)].join('; ')}` : ''} (RULINGS Q34d, Q38b, Q42a)`);
   465	  }
   466	  // Q46b, Q47b: the control's identity comes from A0_REGISTRY for the claim's source engine, never from the claim.
   467	  const a0key = own(ctx.byEngine, own(own(comp, 'source'), 'engine')), entry = own(ctx.a0, a0key);
   468	  if (!entry) why('A0-REGISTRY-NULL', `A0_REGISTRY has no entry for source engine ${own(own(comp, 'source'), 'engine')}; every comparison is a diagnostic until A0 is frozen (RULINGS Q46b, Q47b)`);
   469	  else if (!compositionOk(entry.composition, ctx) || !sha(entry.binarySha256)) why('A0-REGISTRY', 'the A0 registry entry has no bound composition or no binarySha256 (RULINGS Q55a, Q55b)');
