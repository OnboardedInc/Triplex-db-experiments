     4	 * The two independent axes used to read bitemporal facts.
     5	 *
     6	 * `recordedAt` asks what the database knew at an instant. When omitted, reads
     7	 * use the latest recorded state. `validAt` asks what was true in business
     8	 * time. Public read APIs resolve an omitted value to their clock's current
     9	 * instant before reaching a backend.
    10	 */
    11	export const TemporalBasis = Schema.Struct({
    12	  recordedAt: Schema.optional(Schema.Number),
    13	  validAt: Schema.optional(Schema.Number),
    14	});
    15	export type TemporalBasis = typeof TemporalBasis.Type;
    16	
    17	/** A basis whose business-time instant has been resolved by the caller. */
    18	export interface ResolvedTemporalBasis {
    19	  readonly recordedAt?: number;
    20	  /** Internal exact commit cut used by snapshot-stable pagination. */
    21	  readonly recordedPosition?: number;
    22	  readonly validAt: number;
    23	}
    34	export const validateTemporalInstant = (name: string, value: number): void => {
    35	  if (!Number.isFinite(value) || value < 0) {
    36	    throw new Error(`${name} must be a non-negative finite epoch-millisecond instant`);
    37	  }
    38	};
    39	
    40	export const resolveTemporalBasis = (
    41	  basis: TemporalBasis | undefined,
    42	  now: number,
    43	): ResolvedTemporalBasis => {
    44	  validateTemporalInstant("current time", now);
    45	  if (basis?.recordedAt !== undefined) {
    46	    validateTemporalInstant("recordedAt", basis.recordedAt);
    47	  }
    48	  if (basis?.validAt !== undefined) {
    49	    validateTemporalInstant("validAt", basis.validAt);
    50	  }
    51	  return {
    52	    ...(basis?.recordedAt !== undefined ? { recordedAt: basis.recordedAt } : {}),
    53	    validAt: basis?.validAt ?? now,
    54	  };

