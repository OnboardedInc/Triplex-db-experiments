   376	/**
   377	 * Find constraints newly violated or worsened by a transaction at every
   378	 * valid-time boundary represented by its post-state.
   379	 */
   380	export const newlyViolated = (
   381	  current: readonly Triple[],
   382	  operations: readonly TransactOp[],
   383	  rules: readonly Rule[],
   384	  instant: number,
   385	): Effect.Effect<readonly ViolationAt[], CanonicalJson.CanonicalEncodingError> =>
   386	  Effect.gen(function* () {
   387	    if (rules.length === 0) return [];
   388	    const projected = yield* project(current, operations, instant);
   389	    const boundaries = [
   390	      ...new Set(
   391	        [...current, ...projected].flatMap((fact) => [
   392	          fact.validFrom,
   393	          ...(Option.isSome(fact.validTo) ? [fact.validTo.value] : []),
   394	        ]),
   395	      ),
   396	    ].sort((left, right) => left - right);
   397	    const result: ViolationAt[] = [];
   398	    for (const validAt of boundaries) {
   399	      const before = yield* evaluateFacts(current, rules, validAt);
   400	      const after = yield* evaluateFacts(projected, rules, validAt);
   401	      const prior = new Map(before.map((violation) => [identityOf(violation), violation.actual]));
   402	      for (const violation of after) {
   403	        const previousActual = prior.get(identityOf(violation));
   404	        if (previousActual === undefined || violation.actual > previousActual) {
   405	          result.push({ ...violation, validAt });
   406	        }
   407	      }
   408	    }
   409	    return result;
   410	  });
