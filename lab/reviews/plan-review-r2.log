   120	```
   121	XtdbStorageAdapter.withTransaction, outermost branch
   122	  result = run effect                                      :402
   123	  if nothing staged -> return                               :403-404
   124	  NEW  touched = distinct entity_id in state.rows, minus reserved
   125	  NEW  facts   = queryRows({}, undefined, false, undefined, touched)    existing merge of committed rows
   126	                 (<= sourceK) with the staged overlay                  :111-186
   127	  NEW  plan    = planProjection(spec, facts, {instant, position})       pure, lives in core ./entity
   128	  persist(state, operationId, attemptId, plan)              :405-406
   129	    statements = [ASSERT position CAS, ASSERT operation, ASSERT claims, ASSERT identity,   :193-213
   130	                  INSERT tx_assertions ...,                                               :214-230
   131	                  INSERT tx_claims,                                                       :231-245
   132	                  NEW render(plan): DELETE/INSERT projection rows + projection meta row,
   133	                  NEW ASSERT spec fence,
   134	                  INSERT tx_meta, INSERT tx_attempts]                                     :246-267
