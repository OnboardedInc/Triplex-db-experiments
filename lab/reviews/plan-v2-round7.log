    82	      const delay = PARAMS.duplicateDelayMs[0] + next() * (PARAMS.duplicateDelayMs[1] - PARAMS.duplicateDelayMs[0]);
    83	      const atMs = Math.round(t * 1e6) / 1e3;
    84	      const base = { seq: seq++, kind, subject, facts, band, correction, ackLoss, burst };
