import copy, hashlib, json, runpy
n=runpy.run_path('lab/acceptance/build_contract.py',run_name='read_only_review'); obs={o['id']:o for o in n['OBL']}; store={}
def put(v):
 b=v if isinstance(v,bytes) else json.dumps(v,sort_keys=True).encode(); h=hashlib.sha256(b).hexdigest(); store[h]=b; return h
answer=put(b'[]'); binary=put(b'export const fabricated = true;'); module=put(b'// no engine or oracle was run')
comp={k:{'engine':'xtdb','imageDigest':'sha256:'+'1'*64,'configSha256':'2'*64,'slot':'dev'} for k in n['COMPOSITION']['assignments']}
wl={'generatorSourceSha256':'3'*64,'seed':1,'offerScheduleSha256':'4'*64,'window':[0,600],'slot':'dev'}
def rcpt(oid,role='prerequisite',tree='candidate-tree'):
 o=obs[oid]
