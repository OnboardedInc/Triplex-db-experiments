   553	  /** The same answer from the broker's own record on disk; always complete (Q31d fallback). */
   554	  fromLog(
   555	    replicaPosition: number,
   556	    selection: { readonly entities?: readonly string[]; readonly id?: string },
   557	    select: (row: TripleRow) => boolean,
   558	  ): TripleRow[] {
   559	    const after = lsnOf(replicaPosition);
   560	    const first = this.index.findIndex((entry) => entry.lsn > after);
   561	    if (first === -1) return [];
   562	    const previous = first === 0 ? undefined : this.index[first - 1]!;
   563	    const start = this.index[first]!;
   564	    const { frames } = readFramesFrom(
   565	      this.log.segmentPath,
   566	      previous
   567	        ? { offset: start.offset, seed: previous.crc, nextLsn: previous.lsn + 1 }
   568	        : { offset: start.offset, seed: this.seedOfFirst(), nextLsn: start.lsn },
   569	      this.durableLsn,
   570	      Number.MAX_SAFE_INTEGER,
   571	    );
   572	    const latest = new Map<string, TripleRow>();
   573	    const entities = selection.entities ? new Set(selection.entities) : undefined;
   574	    for (const frame of frames) {
   575	      if (frame.kind !== FrameKind.COMMIT_GROUP) continue;
   576	      for (const member of decodeCommitGroup(frame.payload).members)
   577	        for (const row of member.rows) {
   578	          if (selection.id !== undefined && row.id !== selection.id) continue;
   579	          if (entities && !entities.has(row.entity_id)) continue;
   580	          latest.set(row.id, row);
   581	        }
   582	    }
   583	    return [...latest.values()].filter(select);
   584	  }
