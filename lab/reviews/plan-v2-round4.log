   118	def render(d, scale):
   119	    """Canonical text with exactly `scale` fractional digits."""
   120	    neg, i, f = split(d)
   121	    if len(f) > scale:
   122	        raise DecimalKeyError("more fractional digits than scale")
   123	    return ("-" if neg else "") + (i or "0") + ("." + f.ljust(scale, "0") if scale else "")
