    31	MAX_INT_DIGITS = 99          # capacity of the two-digit length field
    32	KERNEL_MAX_PRECISION = 38    # RULINGS Q22 kernel maximum
    33	DIGITS = "0123456789"
    34	_COMP = str.maketrans("0123456789", "9876543210")
    35	
    36	
    37	class DecimalKeyError(ValueError):
    38	    pass
    39	
    40	
    41	# ---------------------------------------------------------------- encoding ---
    42	
    43	def split(d, strip_frac=True):
    44	    """(negative, I, F): I = integer digits without leading zeros, F = fraction digits
    45	    without trailing zeros.  Rejects NaN, Infinity, negative zero, oversize values.
    46	    strip_frac=False exists only so a mutant can keep trailing zeros."""
    47	    if not isinstance(d, Decimal) or not d.is_finite():
    48	        raise DecimalKeyError("not a finite Decimal")
    49	    sign, digs, exp = d.as_tuple()
    50	    if d.adjusted() >= MAX_INT_DIGITS and any(digs):
    51	        raise DecimalKeyError("integer part has more than 99 digits")
    52	    if exp < -10_000:
    53	        raise DecimalKeyError("too many fractional digits")
    54	    s = "".join(map(str, digs))
    55	    if exp >= 0:
    56	        i, f = s + "0" * exp, ""
    57	    else:
    58	        n = -exp
    59	        if len(s) <= n:
    60	            i, f = "", "0" * (n - len(s)) + s
    61	        else:
    62	            i, f = s[:-n], s[-n:]
    63	    i, f = i.lstrip("0"), (f.rstrip("0") if strip_frac else f)
    64	    if not i and not f.strip("0"):
    65	        if sign:
    66	            raise DecimalKeyError("negative zero is rejected")
    67	        return False, "", ""
    68	    if len(i) > MAX_INT_DIGITS:
    69	        raise DecimalKeyError("integer part has more than 99 digits")
    70	    return bool(sign), i, f
    71	
    72	
    73	def encode(d):
    74	    neg, i, f = split(d)
    75	    if not i and not f:
    76	        return "o"
    77	    if not neg:
    78	        return "p%02d%s%s" % (len(i), i, f)
    79	    return "n%02d%s%sz" % (99 - len(i), i.translate(_COMP), f.translate(_COMP))
    80	
    81	
    82	def decode(key):
    83	    """Strict inverse of encode.  Raises DecimalKeyError for anything encode cannot emit."""
    84	    if not isinstance(key, str) or not key:
    85	        raise DecimalKeyError("empty key")
    86	    if key == "o":
    87	        return Decimal(0)
    88	    if key[0] == "p":
    89	        neg, body = False, key[1:]
    90	    elif key[0] == "n":
    91	        if len(key) < 4 or key[-1] != "z":
    92	            raise DecimalKeyError("negative key without terminator")
    93	        neg, body = True, key[1:-1]
    94	    else:
    95	        raise DecimalKeyError("bad class marker")
    96	    if len(body) < 2 or any(c not in DIGITS for c in body):
    97	        raise DecimalKeyError("bad body")
    98	    ll, rest = int(body[:2]), body[2:]
    99	    if neg:
   100	        ll, rest = 99 - ll, rest.translate(_COMP)
   101	    if len(rest) < ll:
   102	        raise DecimalKeyError("length field exceeds body")
   103	    i, f = rest[:ll], rest[ll:]
   104	    if (i and i[0] == "0") or (f and f[-1] == "0") or (not i and not f):
   105	        raise DecimalKeyError("non-canonical digits")
   106	    return Decimal(("-" if neg else "") + (i or "0") + ("." + f if f else ""))
