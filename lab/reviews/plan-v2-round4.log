   109	def parse_text(text):
   110	    """Strict input grammar: -?(0|[1-9][0-9]*)(\\.[0-9]+)?  ; negative zero rejected."""
   111	    if not re.fullmatch(r"-?(0|[1-9][0-9]*)(\.[0-9]+)?", text, re.ASCII):
   112	        raise DecimalKeyError("bad decimal text")
   113	    d = Decimal(text)
   114	    split(d)  # rejects -0
   115	    return d
