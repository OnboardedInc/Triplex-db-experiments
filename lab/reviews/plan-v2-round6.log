    59	_INTEGER_LEXEME = re.compile(r"-?(0|[1-9][0-9]*)")
    60	_COORDINATE_FIELDS = ("stream", "epoch", "offset", "ordinal")
    61	
    62	
    63	def _coordinate_int(raw, what, minimum=None):
    64	    """An integer field of a position, written as a JSON integer lexeme (no fraction or
    65	    exponent: a position is not a measured number)."""
    66	    if isinstance(raw, bool) or not (isinstance(raw, int) or (isinstance(raw, str) and _INTEGER_LEXEME.fullmatch(raw))):
    67	        raise V.OracleInputError(f"position {what} must be an integer, got {raw!r}")
    68	    value = int(raw)
    69	    if minimum is not None and value < minimum:
    70	        raise V.OracleInputError(f"position {what} must be >= {minimum}, got {value}")
    71	    return value
    72	
    73	
    74	def coordinate_key(raw):
    75	    """RULINGS Q31c / ACC POSITION: a receipt position is either an integer (today's dense
    76	    scope counters) or a coordinate (stream, epoch, offset, ordinal) written as an object
    77	    with those four fields or a four-element list, ordered lexicographically. Streams may be
    78	    strings or integers (integers sort before strings; one scope normally uses one stream
    79	    naming). Returns ("int", n) or ("coord", stream key, epoch, offset, ordinal)."""
    80	    if isinstance(raw, (dict, list)):
    81	        if isinstance(raw, dict):
    82	            if set(raw) != set(_COORDINATE_FIELDS):
    83	                raise V.OracleInputError(f"position coordinate needs exactly the fields {_COORDINATE_FIELDS}")
    84	            parts = [raw[f] for f in _COORDINATE_FIELDS]
    85	        else:
    86	            if len(raw) != 4:
    87	                raise V.OracleInputError("position coordinate list needs four elements")
    88	            parts = list(raw)
    89	        stream = parts[0]
    90	        if isinstance(stream, V.Lex) or (isinstance(stream, int) and not isinstance(stream, bool)):
    91	            stream_key = (0, _coordinate_int(stream, "stream"))
    92	        elif isinstance(stream, str):
    93	            stream_key = (1, stream)
    94	        else:
    95	            raise V.OracleInputError(f"position stream must be a string or integer, got {stream!r}")
    96	        return ("coord", stream_key) + tuple(_coordinate_int(p, f, 0) for p, f in zip(parts[1:], _COORDINATE_FIELDS[1:]))
    97	    return ("int", _coordinate_int(raw, "integer"))
