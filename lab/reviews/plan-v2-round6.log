   652	def q_compare(run, query):
   653	    """Equality and order between two operands (typed values, untyped constants on the
   654	    right, or expressions such as ["to-number", v] for DEC-CONVERTED-COMPARE). Each of
   655	    eq/ne/lt/gt is a boolean or the preflight error the contract pins (CMP-INT-FLOAT:
   656	    eq false, ordered E-MIXED-FAMILY; CMP-DECIMAL-CROSS: every comparison E-MIXED-FAMILY).
   657	    identical / sameGroup report value identity (CMP-NEGZERO: -0.0 and +0.0 are one)."""
   658	    a = X.evaluate(_decode_expr(query["left"]))
   659	    right = query["right"]
   660	    b = X.evaluate(_decode_expr(right)) if isinstance(right, (list, V.Obj)) else V.decode_constant(right)
   661	    mode = query.get("compare", "typed")
   662	    same = isinstance(b, V.Value) and a == b
