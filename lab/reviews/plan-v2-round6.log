   100	def coordinate_output(raw):
   101	    """The position as the receipt wrote it, normalized: an integer, or an object with the
   102	    four coordinate fields in order."""
   103	    key = coordinate_key(raw)
   104	    if key[0] == "int":
   105	        return key[1]
   106	    stream = key[1][1]
   107	    return V.OrderedOut(zip(_COORDINATE_FIELDS, (stream,) + key[2:]))
