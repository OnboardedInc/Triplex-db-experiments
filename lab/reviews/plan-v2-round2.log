  2417	            if v and v[0] == "NA":
  2418	                cells[c] = {"status": "NA", "note": v[1]}
  2419	            elif surf == "raw" and v and v[0] == "KL" and r["rawRequired"]:
  2420	                cells[c] = {"status": "EXEMPT", "exception": exc[(r["n"], lanecol[c])], "limits": v[1], "note": v[2]}
