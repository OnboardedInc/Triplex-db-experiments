   836	            "goalClosed": "closed(G, lane, T) = for every O with G in O.goals and lane in O.lanes: closed(O, lane, T); a goal with an obligation in grounding 'policy-pending' cannot close until that policy is frozen in a later contract version",
   837	            "done": "done(T) = closed(G, lane, T) for every G in G1..G10, R, S, L and every lane, on one integrated candidate tree T, plus the integrated verification receipt of section 5.6",
   838	            "statusValues": ["OPEN", "CLOSED"],
   839	        },
   840	        "obligations": OBL,
   841	    }
