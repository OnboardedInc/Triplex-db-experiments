   190	# --------------------------------------------------------------------------- mutation controls
   191	MUTANTS = {
   192	    "M-HALF-OPEN": "validTo treated as inclusive (or validFrom as exclusive) in the visibility filter of the system under test.",
   193	    "M-DROPPED-SUPPORT": "when two live assertions support the same value, retracting one removes the value from the projection, plain triple or derived result.",
   194	    "M-FUTURE-RETIREMENT": "snapshot reads return retractedAt/retractTxId of a retirement recorded after the cut.",
   195	    "M-INT64-ROUND": "int64 values pass through binary64 on the read or write path.",
   196	    "M-ENTITY-TYPE-SWAP": "entity type labels of two EntityTypes swapped in the projection or in hydration.",
   197	    "M-STALE-PROJECTION": "the projection is served one publication behind while the returned basis reports the latest position.",
   198	    "M-CUT-OFF-BY-ONE": "reads use position P-1, or treat recordedAt <= R as < R.",
   199	    "M-NEGZERO": "-0.0 normalized to +0.0 on any path.",
   200	    "M-ICU-ORDER": "text order and range comparison use locale collation instead of codepoint order.",
   201	    "M-SCOPE-LEAK": "the scope predicate or graph selection is dropped from one read path.",
   202	    "M-MASK-RAW": "the snapshot retirement mask is applied to the ordinary raw-lifetime history contract.",
   203	    "M-CONFLICT-PICK": "a card-one conflict is resolved by an arbitrary pick instead of the typed conflict outcome.",
   204	    "M-IDENTITY-COLLAPSE": "same-value assertions in one batch collapse into one assertion identity.",
   205	    "M-JOURNAL-ORDER": "transaction changes are returned in a different order than written.",
   206	    "M-CLAIM-IGNORED": "the command-claim check is skipped, so a duplicate command commits twice.",
   207	    "M-DECORRELATE": "a negation helper omits the correlated-variable re-binding.",
   208	    "M-STALE-REUSE": "a reused derived result is not invalidated after an affecting write.",
   209	    "M-CARD-MANY-DROP": "one element of a cardinality-many array is dropped on hydration or projection.",
   210	}
   211	
   212	# --------------------------------------------------------------------------- closure rules
   213	CLOSURE_RULES = {
   214	    "CR-PASS-ALL": "Every declared case executes in every declared mode for the lane, each result is PASS against the named oracle, executed case ids equal the declared set exactly, and the receipt passes V1-V16.",
   215	    "CR-COUNTEREXAMPLE": "The original counterexample case runs with its original frozen expected answer (oracle file hash unchanged since the first recorded failure) and passes; the raw counterexample text is not edited; CR-PASS-ALL holds.",
   216	    "CR-MUTANT-KILL": "For each listed mutant, a mutation receipt on the same candidate tree (mutation patch hash recorded, oracle and case hashes unchanged) executes the full declared suite and records at least one FAIL; the unmutated suite passes CR-PASS-ALL on that tree.",
   217	    "CR-OBSERVE": "Every required observation level of O-OBS is evidenced and joined to one request or connection identity, within the stated bounds; uncertainty after timeout or lost acknowledgement fails the case.",
   218	    "CR-FAULT": "Every declared fault point is injected at least the stated number of times; after each injection and recovery the post-state equals O-REPLAY through every listed access path; zero ACKed commands lost; zero unresolved outcomes at the end.",
   219	    "CR-STATIC": "Every positive witness compiles and every negative witness fails with the expected diagnostic, against the packed public declarations of the candidate.",
   220	    "CR-SCALE": "The rung's dataset receipt meets the declared counts (verified by independent count queries in the lane language and O-REPLAY analytic counts), the run was admitted under a capacity forecast, and the correctness subsample passes with zero tolerance.",
   792	            errors.append(f"{o['id']}: mutants listed but CR-MUTANT-KILL missing")
   793	        if "CR-MUTANT-KILL" in o["closure"]["rules"] and not o["mutationControls"]:
   794	            errors.append(f"{o['id']}: CR-MUTANT-KILL without mutants")
   795	        if o["receiptScope"] not in ("lane", "engine"):
   796	            errors.append(f"{o['id']}: bad receiptScope")
   797	        if "—" in json.dumps(o, ensure_ascii=False):
   798	            errors.append(f"{o['id']}: em-dash")
   799	    required_mutants = {"M-HALF-OPEN", "M-DROPPED-SUPPORT", "M-FUTURE-RETIREMENT", "M-INT64-ROUND", "M-ENTITY-TYPE-SWAP", "M-STALE-PROJECTION"}
   800	    used = {m for o in OBL for m in o["mutationControls"]}
   801	    for m in required_mutants - used:
