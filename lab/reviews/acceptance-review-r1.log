   908	def render_md():
   909	    path = HERE / "ACCEPTANCE.md"
   910	    text = path.read_text()
   911	    begin, end = "<!-- BEGIN GENERATED OBLIGATIONS -->", "<!-- END GENERATED OBLIGATIONS -->"
   912	    cb, ce = "<!-- BEGIN GENERATED COUNTS -->", "<!-- END GENERATED COUNTS -->"
   913	    a, b = text.index(begin) + len(begin), text.index(end)
   914	    text = text[:a] + "\n\n" + render_sections() + "\n" + text[b:]
   915	    a, b = text.index(cb) + len(cb), text.index(ce)
   916	    text = text[:a] + "\n\n" + counts_table() + "\n\n" + text[b:]
   917	    path.write_text(text)
   918	
