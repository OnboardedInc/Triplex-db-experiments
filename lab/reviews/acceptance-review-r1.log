   850	def render_sections():
   851	    out = []
   852	    for g, title in SECTIONS:
   853	        out.append(f"### {title}\n")
   854	        group = [o for o in OBL if o["goals"][0] == g]
   855	        cross = [o for o in OBL if g in o["goals"][1:]]
   856	        if not group and not cross:
   857	            out.append("No obligations.\n")
   858	        for o in group:
   859	            lanes = ", ".join(o["lanes"]) if o["lanes"] != ALL else "all three"
   860	            scope = "one receipt per lane" if o["receiptScope"] == "lane" else "one receipt per engine (both XTDB lanes share the XTDB receipt)"
   861	            cases = o["cases"]["set"] + (f" ({o['cases'].get('select')})" if o["cases"].get("select") else "")
   862	            if o["cases"].get("also"):
   863	                cases += f", also {o['cases']['also']}"
   864	            if o["cases"].get("executions"):
   865	                cases += f", {o['cases']['executions']} executions"
   866	            cs_status = CASESETS[o["cases"]["set"]]["status"]
   867	            oracle = ", ".join(f"{x} ({ORACLES[x]['status']})" for x in o["oracles"]) or "none (provenance check)"
   868	            closure = " + ".join(o["closure"]["rules"])
   869	            params = o["closure"]["params"]
   870	            if params:
   871	                closure += " with " + json.dumps(params, ensure_ascii=False)
   872	            out.append(f"**`{o['id']}`: {o['title']}.**")
   873	            out.append(f"- Statement: {o['statement']}")
   874	            out.append(f"- Lanes: {lanes}; {scope}.")
   875	            out.append(f"- Cases: {cases}; case set {cs_status}.")
   876	            out.append(f"- Oracle: {oracle}.")
   877	            out.append(f"- Entrypoints: {', '.join(o['entrypoints'])}. Profile: {o['profile']}.")
   878	            out.append(f"- Closure: {closure}.")
   879	            if o["mutationControls"]:
   880	                out.append(f"- Mutation controls: {', '.join(o['mutationControls'])}.")
   881	            out.append(f"- Sources: {'; '.join(o['sources'])}.")
   882	            if o["grounding"] != "grounded":
   883	                out.append(f"- Grounding: **{o['grounding']}**.")
   884	            if o["notes"]:
   885	                out.append(f"- Notes: {o['notes']}")
   886	            out.append(f"- Status: OPEN on every listed lane (no fresh acceptance receipt exists).")
   887	            out.append("")
   888	        if cross:
   889	            out.append("Also counted in this section: " + ", ".join(f"`{o['id']}`" for o in cross) + ".\n")
   890	    return "\n".join(out)
   891	
