   893	def counts_table():
   894	    rows = ["| Section | xtdb-xtql | xtdb-sql | qlever-sparql | of which policy-pending | of which derived |", "| --- | ---: | ---: | ---: | ---: | ---: |"]
   895	    total = {lane: 0 for lane in LANES}
   896	    for g, _ in SECTIONS:
   897	        os_ = [o for o in OBL if g in o["goals"]]
   898	        c = {lane: sum(1 for o in os_ if lane in o["lanes"]) for lane in LANES}
   899	        pp = sum(1 for o in os_ if o["grounding"] == "policy-pending")
   900	        dv = sum(1 for o in os_ if o["grounding"] == "derived")
   901	        rows.append(f"| {g} | {c['xtdb-xtql']} | {c['xtdb-sql']} | {c['qlever-sparql']} | {pp} | {dv} |")
   902	    for lane in LANES:
   903	        total[lane] = sum(1 for o in OBL if lane in o["lanes"])
   904	    rows.append(f"| distinct obligations | {total['xtdb-xtql']} | {total['xtdb-sql']} | {total['qlever-sparql']} | {sum(1 for o in OBL if o['grounding']=='policy-pending')} | {sum(1 for o in OBL if o['grounding']=='derived')} |")
   905	    return "\n".join(rows)
   906	
