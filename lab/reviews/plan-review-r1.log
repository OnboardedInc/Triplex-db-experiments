    69	export const make = <const N extends string, const A extends Uses>(
    70	  name: N,
    71	  definition: { readonly attributes: A },
    72	): EntityType<N, A> => {
    73	  if (!ENTITY_TYPE_NAME.test(name)) {
    74	    throw new TypeError(`Entity type identity must be PascalCase; received ${name}`);
    75	  }
    76	
    77	  const fields: Record<string, TypeExpr.StructField> = {};
    78	  const handles: Record<string, AttributeHandle<Attribute.AnyDefinition>> = {};
    79	  const usage: Record<string, CanonicalJson.CanonicalValue> = {};
    80	  const definitions = new Map<string, Attribute.AnyDefinition>();
    81	  const constraints: GraphConstraint.Definition[] = [];
    82	
    83	  for (const [property, attributeUse] of Object.entries(definition.attributes)) {
    84	    if (RESERVED_PROPERTIES.has(property)) {
    85	      throw new TypeError(`Entity attribute alias ${property} is reserved by the EntityType API`);
    86	    }
    87	    const attribute = attributeUse.attribute;
    88	    if (definitions.has(attribute.key)) {
    89	      throw new TypeError(
    90	        `Entity type ${name} uses ${attribute.key} more than once; one global attribute may have only one usage in an entity type`,
    91	      );
    92	    }
    93	    const valueType =
    94	      attributeUse.cardinality === "many" ? TypeExpr.list(attribute.type) : attribute.type;
    95	    fields[attribute.key] = attributeUse.required
    96	      ? TypeExpr.required(valueType)
    97	      : TypeExpr.optional(valueType);
    98	    usage[property] = {
    99	      attribute: attribute.key,
   100	      required: attributeUse.required,
   101	      cardinality: attributeUse.cardinality,
   102	      unique: attributeUse.unique,
   103	    };
   104	    definitions.set(attribute.key, attribute);
   105	    handles[property] = {
   106	      key: attribute.key,
   107	      type: attribute.type,
   108	      required: attributeUse.required,
   109	      cardinality: attributeUse.cardinality,
   110	      unique: attributeUse.unique,
   111	      definition: attribute,
   112	      assertion: (value, options) => Attribute.assertion(attribute, value, options),
   113	    };
   114	    if (attributeUse.required) constraints.push(GraphConstraint.required(name, attribute.key));
   115	    if (attributeUse.cardinality === "one") {
   116	      constraints.push(GraphConstraint.cardinality(name, attribute.key, 1));
   117	    }
   118	    if (attributeUse.unique) constraints.push(GraphConstraint.unique(name, attribute.key));
   119	    if (attribute.type._tag === "Ref") {
   120	      constraints.push(GraphConstraint.referenceTarget(name, attribute.key, attribute.type.kind));
   121	    }
   122	  }
   123	
   124	  const schema = TypeExpr.struct(fields);
   125	  const node = Effect.gen(function* () {
   126	    const constraintNodes = yield* Effect.all(constraints.map((constraint) => constraint.node));
   127	    return yield* ConfigNode.makeTyped({
   128	      kind: ENTITY_SCHEMA_KIND,
   129	      key: name,
   130	      type: DefinitionType,
   131	      attrs: { entityType: name, type: schema, attributes: usage },
   132	      children: constraintNodes.map((constraint) => ({ rel: "constraint", node: constraint })),
   133	      refs: [...definitions.values()]
   134	        .sort((left, right) => left.key.localeCompare(right.key))
   135	        .map((attribute) => ({ rel: "uses-attribute", kind: Attribute.KIND, key: attribute.key })),
   136	    });
   137	  });
   138	  const nodes = Effect.all([
   139	    ...[...definitions.values()]
   140	      .sort((left, right) => left.key.localeCompare(right.key))
   141	      .map((attribute) => attribute.node),
   142	    node,
   143	  ]);
   144	  const entity = {
   145	    entityType: name,
   146	    schema,
   147	    attributes: handles as Handles<A>,
   148	    constraints,
   149	    node,
   150	    nodes,
   151	    ...handles,
   152	  };
   153	  return entity as EntityType<N, A>;
   154	};

