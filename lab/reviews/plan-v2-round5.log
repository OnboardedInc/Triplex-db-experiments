    44	  const x = gate => get(gate, 'xtdb'), q = gate => get(gate, 'qlever');
    45	  const rows = {
    46	    G0: `| G0 pure | ${cell(x('G0').receipt, x('G0').file ?? '', 'xtql')} | ${cell(x('G0').receipt, x('G0').file ?? '', 'sql')} | ${cell(q('G0').receipt, q('G0').file ?? '', 'q')} |`,
    47	    G1: `| G1 unchanged44 | ${cell(x('G1').receipt, x('G1').file ?? '', 'xtql')} | (shared foundation) | ${cell(q('G1').receipt, q('G1').file ?? '', 'q')} |`,
    48	    G2: `| G2 native142 | ${cell(x('G2').receipt, x('G2').file ?? '', 'xtql')} | ${cell(x('G2').receipt, x('G2').file ?? '', 'sql')} | ${cell(q('G2').receipt, q('G2').file ?? '', 'q')} |`,
    49	  };
