    19	    const language = column === 'xtql' ? 'xtql' : 'xtdb-sql';
    20	    const pure = receipt.languages?.answer?.[language] ?? 0;
    21	    const passed = receipt.languages?.passByAnswer?.[language] ?? 0;
    22	    if (receipt.verdict === 'PASS' && pure === 142 && passed === 142) return `PASS@full ${link}`;
    23	    return `PARTIAL(${language}-pure ${pure}/142 executions, ${passed} pass; run ${receipt.verdict} ${c.pass ?? 0}/${c.expected ?? '?'} on ${receipt.scope}) ${link}`;
    24	  }
    25	  if (receipt.verdict === 'PASS') return `PASS@${receipt.scope} ${link}`;
    26	  if (receipt.verdict === 'PASS_SUBSET') return `PARTIAL(${receipt.scope}, all pass) ${link}`;
    27	  return `FAIL(${c.pass ?? 0}/${c.expected ?? c.executed ?? '?'} pass on ${receipt.scope}) ${link}`;
    28	}
