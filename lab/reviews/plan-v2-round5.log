    43	export function classifyLanguages(trace) {
    44	  const queries = (trace ?? []).filter(item => item && item.operation === 'public-native-query');
    45	  const answer = new Set(queries.map(q => q.language).filter(Boolean));
    46	  const strict = new Set(answer);
    47	  for (const q of queries) for (const s of q.steps ?? []) if (s.language) strict.add(s.language);
    48	  const label = set => set.size === 0 ? 'none' : set.size > 1 ? 'hybrid' : [...set][0];
    49	  return { answer: label(answer), strict: label(strict), queries: queries.length, answerLanguages: [...answer].sort(), strictLanguages: [...strict].sort() };
    50	}
