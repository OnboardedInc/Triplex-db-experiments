    53	  if (heading < 0) fail('SCORECARD', 'no "## Gates by lane" heading in lab/SCORECARD.md');
    54	  const stamp = `<!-- G0-G2 rows rebuilt by lab/bin/scorecard.mjs from ${ref}@${sha.slice(0, 12)} (${files.length} receipt files) -->`;
    55	  if (lines[heading + 1]?.startsWith('<!-- G0-G2 rows rebuilt')) lines[heading + 1] = stamp; else lines.splice(heading + 1, 0, stamp);
